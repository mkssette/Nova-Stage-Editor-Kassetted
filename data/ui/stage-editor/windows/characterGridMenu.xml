<vbox id="iconSelector" width="410" height="215" padding="8" style="background-color: #2b2b2b; border: 1px solid #111111;">
    <style>
        .character-btn {
            background-color: #383838;
            border: 1px solid #1a1a1a;
            color: #ffffff;
            font-size: 11px;
            padding: 4px;
        }
        .character-btn:hover {
            background-color: #4a4a4a;
        }
    </style>
    <textfield id="charSearchField" placeholder="Search characters..." width="390" />
    <scrollview id="charSelectScroll" width="390" height="150" contentWidth="100%">
        <grid id="characterGrid" columns="5" width="100%" style="spacing: 4px;" />
    </scrollview>
    <label id="charIconName" text="(choose a character)" width="100%" textAlign="center" style="color: #ffffff;" />
</vbox>
