<window title="Editing $propID" width="400" maximizable="false" minimizable="false" collapsable="false" closable="false">
    <grid width="100%">
        <label text="Prop Name:" style="padding: 2px;" verticalAlign="center"/>
        <textfield  id="editPropWindowNameTextField" placeholder="Prop Name" width="100%" verticalAlign="center" validator="required"/>  

        <label text="Asset Path:" style="padding: 2px;" verticalAlign="center"/>
        <textfield  id="editPropWindowAssetPathTextField" placeholder="Asset Path" width="100%" verticalAlign="center" validator="required"/> 

        <label text="Animation Type:" style="padding: 2px;" verticalAlign="center"/>
        <option-stepper width="100%" id="editPropWindowAnimationStepper">
            <data>
                <item text="Sparrow" data="sparrow"/>
                <item text="Multi-Sparrow" data="multisparrow" />
                <item text="Texture Atlas" data="textureatlas" />
            </data>
        </option-stepper>

        <label text="Color Tint:" style="padding: 2px;" verticalAlign="center"/>
        <color-picker-popup id="editPropWindowColorPicker" width="100%" value="#FFFFFF"/>

        <label text="Blend Mode:" style="padding: 2px;" verticalAlign="center"/>
        <dropdown id="editPropWindowBlendModeDropdown" text="None" width="100%" searchable="true">
            <data>
                <item text="None" data="-1" id=""/>
                <item text="Add" data="0" id="add"/>
                <item text="Alpha" data="1" id="alpha"/>
                <item text="Darken" data="2" id="darken"/>
                <item text="Difference" data="3" id="difference"/>
                <item text="Erase" data="4" id="erase"/>
                <item text="Hard Light" data="5" id="hardlight"/>
                <item text="Invert" data="6" id="invert"/>
                <item text="Layer" data="7" id="layer"/>
                <item text="Lighten" data="8" id="lighten"/>
                <item text="Multiply" data="9" id="multiply"/>
                <item text="Normal" data="10" id="normal"/>
                <item text="Overlay" data="11" id="overlay"/>
                <item text="Screen" data="12" id="screen"/>
                <item text="Shader" data="13" id="shader"/>
                <item text="Subtract" data="14" id="subtract"/>
            </data>
        </dropdown>

        <label text="Position:" style="padding: 2px;" verticalAlign="center"/>
        <hbox width="100%">
            <number-stepper id="editPropWindowPosStepperX" pos="0" step="1" width="100%" verticalAlign="center"/>
            <number-stepper id="editPropWindowPosStepperY" pos="0" step="1" width="100%" verticalAlign="center"/>
        </hbox>

        <label text="Scroll:" style="padding: 2px;" verticalAlign="center"/>
        <hbox width="100%">
            <number-stepper id="editPropWindowScrollStepperX" min="0" pos="0" step="0.1" width="100%" verticalAlign="center"/>
            <number-stepper id="editPropWindowScrollStepperY" min="0" pos="0" step="0.1" width="100%" verticalAlign="center"/>
        </hbox>

        <label text="Scale:" style="padding: 2px;" verticalAlign="center"/>
        <number-stepper id="editPropWindowScaleStepper" min="0" pos="0" step="0.1" width="100%" verticalAlign="center"/>
        
        <label text="Alpha:" style="padding: 2px;" verticalAlign="center"/>
        <number-stepper id="editPropWindowAlphaStepper" min="0" max="1" pos="0" step="0.1" width="100%" verticalAlign="center"/>
        
        <label text="Angle:" style="padding: 2px;" verticalAlign="center"/>
        <number-stepper id="editPropWindowAngleStepper" pos="0" step="1" width="100%" verticalAlign="center" min="-1" max="360"/>

        <label text="Dance Every:" style="padding: 2px;" verticalAlign="center"/>
        <number-stepper id="editPropWindowDanceStepper" min="0" pos="0" step="1" width="100%" verticalAlign="center"/>
        
        <label text="Z-Index/Layer:" style="padding: 2px;" verticalAlign="center"/>
        <number-stepper id="editPropWindowZIndexStepper" min="0" pos="0" step="1" width="100%" verticalAlign="center"/>
        
    </grid>
    <hbox width="100%" style="padding: 10px;">
        <spacer width="50%"/>
        <label text="Flip X:" style="padding: 2px;" verticalAlign="center"/>
        <checkbox id="editPropWindowFlipXCheckbox"/>
        <spacer width="10%"/>
        <label text="Flip Y:" style="padding: 2px;" verticalAlign="center"/>
        <checkbox id="editPropWindowFlipYCheckbox"/>
        <spacer width="10%"/>
        <label text="Pixel:" style="padding: 2px;" verticalAlign="center"/>
        <checkbox id="editPropWindowIsPixelCheckbox"/>
    </hbox>
    <button id="editPropWindowAnimationsButton" text="Edit Animations" width="100%"/>
    <window-footer width="100%">
        <spacer width="100%" />
        <button text="Close/Apply" id="editPropWindowConfirm" />
    </window-footer>
</window>