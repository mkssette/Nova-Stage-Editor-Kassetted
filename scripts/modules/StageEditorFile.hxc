import flixel.FlxG;
import flixel.util.FlxTimer;
import haxe.ui.RuntimeComponentBuilder;
import funkin.modding.PolymodHandler;
import funkin.util.FileUtil;
import funkin.play.stage.Stage;
import haxe.Json;
import haxe.ui.events.MouseEvent;
import haxe.ui.notifications.NotificationType;

class StageEditorFile {
    public static function init(state:Dynamic) {
        var saveStageAsButton = state.menuBar.findComponent("saveStageAs");
        var saveStageAsCallback = ()->{
            var newStageDialog = RuntimeComponentBuilder.build(Paths.ui("stage-editor/dialogs/saveAsDialog"));
            newStageDialog.screenCenter();
            newStageDialog.showDialog(true);
            state.cancelInput = true;

            for (i in PolymodHandler.getAllMods()) {
			    newStageDialog.findComponent("modFolderList").dataSource.add({ text: i.title + " (" + i.id + ")" });
            }
            newStageDialog.findComponent("modFolderList").selectedItem = { text: "None" };

            var cancelButton = newStageDialog.findComponent("dialogCancel");
            cancelButton.onClick = ()->{
                state.cancelInput = false;
                newStageDialog.hide();
                newStageDialog.destroy();
            }
        }
        state.bind(saveStageAsButton, MouseEvent.CLICK, saveStageAsCallback);
        state.newKeybind(["CONTROL", "SHIFT", "S"], saveStageAsCallback);

        var newStageButton = state.menuBar.findComponent("newStage");
        var newStageCallback = ()->{

            var newStageDialog = RuntimeComponentBuilder.build(Paths.ui("stage-editor/dialogs/newStageDialog"));
            newStageDialog.screenCenter();
            newStageDialog.showDialog(true);
            state.cancelInput = true;

            for (i in PolymodHandler.getAllMods()) {
			    newStageDialog.findComponent("modFolderList").dataSource.add({ text: i.title + " (" + i.id + ")" });
            }
            newStageDialog.findComponent("modFolderList").selectedItem = { text: "None" };

            var cancelButton = newStageDialog.findComponent("dialogCancel");
            cancelButton.onClick = ()->{
                state.cancelInput = false;
                newStageDialog.hide();
                newStageDialog.destroy();
            }

            var continueButton = newStageDialog.findComponent("dialogContinue");
            continueButton.onClick = ()->{
                var continu = true;
                if (newStageDialog.findComponent("modFolderList").text == "None") {
                    state.newNotification("Error!", 'Could not create stage!\nPlease select a mod folder first.', NotificationType.Error, 5000);
                    continu = false;
                } else if (newStageDialog.findComponent("stageNameField").text == "" || newStageDialog.findComponent("stageNameField").text == null) {
                    state.newNotification("Error!", 'Could not create stage!\nStage Name must not be empty.', NotificationType.Error, 5000);
                    continu = false;
                } else if (newStageDialog.findComponent("fileNameField").text == "" || newStageDialog.findComponent("fileNameField").text == null) {
                    state.newNotification("Error!", 'Could not create stage!\nFile Name must not be empty.', NotificationType.Error, 5000);
                    continu = false;
                }

                if (continu) {
                    for (i in PolymodHandler.getAllMods()) {
				        if (i.title + " (" + i.id + ")" == newStageDialog.findComponent("modFolderList").text) {
                            var path = "mods/" + i.id + "/data/stages/" + newStageDialog.findComponent("fileNameField").text + ".json";

                            var stageToSave = new Stage("mainStage");
                            stageToSave._data.directory = "Generated By: " + state.editorTitle + " v" + state.editorVersion;
                            stageToSave._data.version = "1.0.0";
                            stageToSave._data.cameraZoom = 1;
                            stageToSave._data.characters.bf.position = [0, 0];
                            stageToSave._data.characters.gf.position = [0, 0];
                            stageToSave._data.characters.dad.position = [0, 0];
                            stageToSave._data.characters.bf.cameraOffsets = [0, 0];
                            stageToSave._data.characters.gf.cameraOffsets = [0, 0];
                            stageToSave._data.characters.dad.cameraOffsets = [0, 0];
                            stageToSave._data.props = [];
                            stageToSave._data.name = newStageDialog.findComponent("stageNameField").text;

                            var parsed = Json.parse(stageToSave._data.serialize());

                            FileUtil.writeStringToPath(path, Json.stringify(parsed, null, "\t"));

                            state.stageList.dataSource.add({ text: newStageDialog.findComponent("stageNameField").text, id: newStageDialog.findComponent("fileNameField").text });
                            state.customStageRegistry.set(newStageDialog.findComponent("fileNameField").text, stageToSave._data);

                            state.stageList.selectedItem = { text: newStageDialog.findComponent("stageNameField").text, id: newStageDialog.findComponent("fileNameField").text };

                            state.newNotification("Success!", 'Successfully created stage "' + newStageDialog.findComponent("stageNameField").text + '"', NotificationType.Success, 5000);
                        }
                    }

                    state.cancelInput = false;
                    newStageDialog.hide();
                    newStageDialog.destroy();   
                }
            }
        }
        state.bind(newStageButton, MouseEvent.CLICK, newStageCallback);
        state.newKeybind(["CONTROL", "N"], newStageCallback);

        var deleteStageButton = state.menuBar.findComponent("deleteStage");
        deleteStageButton.onClick = ()->{
            if (state.currentStage.id == "mainStage") {
                state.newNotification("Error!", 'Could not delete stage!\n"assets" folder is protected.', NotificationType.Error, 5000);
                return;
            }

            var deleteStageCallback = ()->{
                for (mod in PolymodHandler.getAllMods()) {
                    if (FileUtil.directoryExists("mods/" + mod.id + "/data/stages/")) {
                        if (FileUtil.readDir("mods/" + mod.id + "/data/stages/").contains(state.currentStage.id + ".json")) {
                            var path = "mods/" + mod.id + "/data/stages/" + state.currentStage.id + ".json";
                            FileUtil.deleteFile(path);

                            state.newNotification("Success!", 'Successfully deleted stage "' + state.currentStage.stageName + '"', NotificationType.Success, 5000);

                            state.blacklist.push(state.currentStage.stageName);

                            new FlxTimer().start(0.1, ()->{
                                state.reloadStageList();
                                state.stageList.selectedItem = { text: "Main Stage", id: "mainStage" };
                            });

                        }
                    }
                }
            }

            if (FlxG.keys.pressed.SHIFT) {
                deleteStageCallback();
            } else {
                var deleteStageDialog = RuntimeComponentBuilder.build(Paths.ui("stage-editor/dialogs/deleteStageDialog"));
                
                deleteStageDialog.screenCenter();
                deleteStageDialog.showDialog(true);
                state.cancelInput = true;

                deleteStageDialog.findComponent("dialogContinue").color = 0xFFFF8888;
                deleteStageDialog.findComponent("dialogContinue").onClick = ()->{
                    state.cancelInput = false;
                    deleteStageDialog.hide();
                    deleteStageDialog.destroy();
                    deleteStageCallback();
                }

                deleteStageDialog.findComponent("dialogCancel").color = 0xFFFF8888;
                deleteStageDialog.findComponent("dialogCancel").onClick = ()->{
                    state.cancelInput = false;
                    deleteStageDialog.hide();
                    deleteStageDialog.destroy();
                }
            }

        }

        var saveStageComponent = state.menuBar.findComponent("saveStage");
        var saveStageCallback = ()->{
            if (FlxG.keys.pressed.SHIFT) return;
            
            if (state.currentStage.id == "mainStage") {
                state.newNotification("Error!", 'Could not save stage!\n"assets" folder is protected.', NotificationType.Error, 5000);
                return;
            }
		    for (mod in PolymodHandler.getAllMods()) {
                if (FileUtil.directoryExists("mods/" + mod.id + "/data/stages/")) {
                    if (FileUtil.readDir("mods/" + mod.id + "/data/stages/").contains(state.currentStage.id + ".json")) {
                        var path = "mods/" + mod.id + "/data/stages/" + state.currentStage.id + ".json";
		                FileUtil.deleteFile(path);
                        var parsed = Json.parse(state.currentStage._data.serialize());
                        parsed.directory = "Generated By: " + state.editorTitle + " v" + state.editorVersion;
                        parsed.version = "1.0.0";
		                FileUtil.writeStringToPath(path, Json.stringify(parsed, null, "\t"));

                        state.newNotification("Success!", 'Successfully saved stage to "' + path + '"', NotificationType.Success, 5000);
                        return;
                    }
                }
            }
        }
        
        state.bind(saveStageComponent, MouseEvent.CLICK, saveStageCallback);
        state.newKeybind(["CONTROL", "S"], saveStageCallback);
    }
}
