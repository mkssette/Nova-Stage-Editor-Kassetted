    function new() {
        super('StageEditorTheSecond');
    }

    function compareData(a, b) {
        var same = true;
        if (a != null && b != null) {
            var index = 0;
            for (i in a) {
                var e = b[index];
                // trace(i.name, e.name);
                if (i != null && e != null) {
                    same = i.name != e.name ? false : same;
                    same = i.position[0] != e.position[0] ? false : same;
                    same = i.position[1] != e.position[1] ? false : same;
                    same = i.scale[0] != e.scale[0] ? false : same;
                    same = i.scale[1] != e.scale[1] ? false : same;
                    same = i.alpha != e.alpha ? false : same;
                    same = i.angle != e.angle ? false : same;
                    same = i.blend != e.blend ? false : same;
                    same = i.color != e.color ? false : same;
                    same = i.flipX != e.flipX ? false : same;
                    same = i.flipY != e.flipY ? false : same;
                    same = i.zIndex != e.zIndex ? false : same;
                }
                index++;
            }
        } else {
            same = false;
        }
        return same;
    }

    function redoCallback() {
        if (cancelInput) return;
        if (redoHistory.length - 1 >= 0) {
            var data = [];
            for (i in currentStage.members) {
                data.push({
                    name: i.name,
                    position: [i.x, i.y],
                    scale: [i.scale.x, i.scale.y],
                    alpha: i.alpha,
                    angle: i.angle,
                    blend: i.blend,
                    color: i.color,
                    flipX: i.flipX,
                    flipY: i.flipY,
                    zIndex: i.zIndex
                });
            }
            if (!compareData(history[history.length-1], data))
                history.push(Reflect.copy(data));
            var cur = redoHistory.pop();
            for (i in cur) {
                for (member in currentStage.members) {
                    if (member.name == i.name) {
                        member.x = i.position[0];
                        member.y = i.position[1];
                        member.scale.x = i.scale[0];
                        member.scale.y = i.scale[1];
                    }
                }
            }
        }
    }
    
    function undoCallback() {
        if (cancelInput) return;
        if (history.length - 1 >= 0) {
            var data = [];
            for (i in currentStage.members) {
                data.push({
                    name: i.name,
                    position: [i.x, i.y],
                    scale: [i.scale.x, i.scale.y],
                    alpha: i.alpha,
                    angle: i.angle,
                    blend: i.blend,
                    color: i.color,
                    flipX: i.flipX,
                    flipY: i.flipY,
                    zIndex: i.zIndex
                });
            }
            if (!compareData(redoHistory[redoHistory.length-1], data))
                redoHistory.push(Reflect.copy(data));
            var cur = history.pop();
            for (i in cur) {
                for (member in currentStage.members) {
                    if (member.name == i.name) {
                        member.x = i.position[0];
                        member.y = i.position[1];
                        member.scale.x = i.scale[0];
                        member.scale.y = i.scale[1];
                    }
                }
            }
        } 
    }

    function create() {
        super.create();
        Cursor.show();
        outlineShader.scriptCall('setThickness', [10]);

        save.bind("nova-editors", "NebulaStellaNova");
        if (save.data.editorSong == null) {
            save.data.editorSong = {
                title: "Artistic Expression",
                key: "chartEditorLoop"
            }
        }
		FunkinSound.playMusic(save.data.editorSong.key, {startingVolume: 0, overrideExisting: true, restartTrack: false, persist: true, loop: true});
		FlxG.sound.music.fadeIn(0.5 /* Duration */, 0, 1);

		var chartEditor = new ChartEditorState();

        camBackground = new FlxCamera();
        camBackground.bgColor = 0xFF000000;
        FlxG.cameras.add(camBackground, false);

        camGame = new FlxCamera();
        camGame.bgColor = 0x00000000;
        FlxG.cameras.add(camGame, false);

        camInteract = new FlxCamera();
        camInteract.bgColor = 0x00000000;
        FlxG.cameras.add(camInteract, false);

        camHUD = new FlxCamera();
        camHUD.bgColor = 0x00000000;
        FlxG.cameras.add(camHUD, true);

        trace("\n\n\n\n\n\n");
        for (i in PolymodHandler.getAllMods()) {
            if (i.title == editorTitle) {
                editorFolder = i.id;
                editorVersion = i.modVersion.version.join(".");
            } 
            if (i.title == "Nova Character Editor") {
                hasCharacterEditorInstalled = true;
            }
        }

        var nameList = [];
        var idList = [];
        for (i in CharacterDataParser.characterCache.keys()) {
            nameList.push(CharacterDataParser.characterCache.get(i).name);
            if (save.data.precacheChars) {
                var c = CharacterDataParser.characterCache.get(i);
                var assetsToLoad = [];
                assetsToLoad.push(c.assetPath);
                for (i in c.animations) {
                    if (i.assetPath != null) {
                        assetsToLoad.push(i.assetPath);
                    }
                }
                for (i in assetsToLoad) {
                    new FunkinSprite().loadGraphic(Paths.image(i));
                }
            }
            idList.push(CharacterDataParser.characterCache.get(i).id);
        }
        nameList.sort(SortUtil.alphabetically);
        idList.sort(SortUtil.alphabetically);

        stageRegistry = new StageRegistry();
        stageRegistry.loadEntries();

        var bg = new FunkinSprite(0, 0).loadGraphic(Paths.image('menuDesat'));
		bg.scrollFactor.set(0, 0);
		bg.setGraphicSize(FlxG.width, FlxG.height);
		bg.updateHitbox();
		bg.screenCenter();
		bg.alpha = 0.25;
		bg.cameras = [camBackground];
		add(bg);

        menuBar = RuntimeComponentBuilder.build(Paths.ui("stage-editor/menubar"));
        menuBar.findComponent("menuBarTitle").text = editorTitle + " v" + editorVersion;

        /* menuBar.findComponent("undo").onClick = ()->{
            undoCallback();
        } */

        var resetCamera = menuBar.findComponent("resetCamera");

        resetCameraCallback = () -> FlxTween.tween(camGame, { zoom: currentStage.camZoom }, 0.25, { ease: FlxEase.quartOut });

        bind(resetCamera, MouseEvent.CLICK, resetCameraCallback);
        newKeybind(["CONTROL", "SHIFT", "R"], resetCameraCallback);

        menuBar.findComponent("precacheCharacters").selected = save.data.precacheChars;
        menuBar.findComponent("precacheCharacters").onChange = ()->{
            save.data.precacheChars = menuBar.findComponent("precacheCharacters").selected;
        }

        menuBar.findComponent("precacheStages").selected = save.data.precacheStages;
        menuBar.findComponent("precacheStages").onChange = ()->{
            save.data.precacheStages = menuBar.findComponent("precacheStages").selected;
        }

        add(menuBar);

        var saveStageAsButton = menuBar.findComponent("saveStageAs");
        var saveStageAsCallback = ()->{
            var newStageDialog = RuntimeComponentBuilder.build(Paths.ui("stage-editor/dialogs/saveAsDialog"));
            // add(newStageDialog);
            newStageDialog.screenCenter();
            newStageDialog.showDialog(true);
            cancelInput = true;

            for (i in PolymodHandler.getAllMods()) {
			    newStageDialog.findComponent("modFolderList").dataSource.add({ text: i.title + " (" + i.id + ")" });
            }
            newStageDialog.findComponent("modFolderList").selectedItem = { text: "None" };

            var cancelButton = newStageDialog.findComponent("dialogCancel");
            cancelButton.onClick = ()->{
                cancelInput = false;
                newStageDialog.hide();
            }
        }
        bind(saveStageAsButton, MouseEvent.CLICK, saveStageAsCallback);
        newKeybind(["CONTROL", "SHIFT", "S"], saveStageAsCallback);

        var newStageButton = menuBar.findComponent("newStage");
        var newStageCallback = ()->{

            var newStageDialog = RuntimeComponentBuilder.build(Paths.ui("stage-editor/dialogs/newStageDialog"));
            // add(newStageDialog);
            newStageDialog.screenCenter();
            newStageDialog.showDialog(true);
            cancelInput = true;

            for (i in PolymodHandler.getAllMods()) {
			    newStageDialog.findComponent("modFolderList").dataSource.add({ text: i.title + " (" + i.id + ")" });
            }
            newStageDialog.findComponent("modFolderList").selectedItem = { text: "None" };

            var cancelButton = newStageDialog.findComponent("dialogCancel");
            cancelButton.onClick = ()->{
                cancelInput = false;
                newStageDialog.hide();
            }

            var continueButton = newStageDialog.findComponent("dialogContinue");
            continueButton.onClick = ()->{
                var continu = true;
                if (newStageDialog.findComponent("modFolderList").text == "None") {
                    newNotification("Error!", 'Could not create stage!\nPlease select a mod folder first.', NotificationType.Error, 5000);
                    continu = false;
                } else if (newStageDialog.findComponent("stageNameField").text == "" || newStageDialog.findComponent("stageNameField").text == null) {
                    newNotification("Error!", 'Could not create stage!\nStage Name must not be empty.', NotificationType.Error, 5000);
                    continu = false;
                } else if (newStageDialog.findComponent("fileNameField").text == "" || newStageDialog.findComponent("fileNameField").text == null) {
                    newNotification("Error!", 'Could not create stage!\nFile Name must not be empty.', NotificationType.Error, 5000);
                    continu = false;
                }

                if (continu) {
                    for (i in PolymodHandler.getAllMods()) {
				        if (i.title + " (" + i.id + ")" == newStageDialog.findComponent("modFolderList").text) {
                            var path = "mods/" + i.id + "/data/stages/" + newStageDialog.findComponent("fileNameField").text + ".json";
                            
                            var stageToSave = new Stage("mainStage");
                            stageToSave._data.directory = "Generated By: " + editorTitle + " v" + editorVersion;
                            stageToSave._data.version = "1.0.0";
                            stageToSave._data.cameraZoom = 1;
                            stageToSave._data.characters.bf.position = [0, 0];
                            stageToSave._data.characters.gf.position = [0, 0];
                            stageToSave._data.characters.dad.position = [0, 0];
                            stageToSave._data.characters.bf.cameraOffsets = [0, 0];
                            stageToSave._data.characters.gf.cameraOffsets = [0, 0];
                            stageToSave._data.characters.dad.cameraOffsets = [0, 0];
                            stageToSave._data.props = [];
                            stageToSave._data.name = newStageDialog.findComponent("stageNameField").text;

                            var parsed = Json.parse(stageToSave._data.serialize());

                            FileUtil.writeStringToPath(path, Json.stringify(parsed, null, "\t"));

                            stageList.dataSource.add({ text: newStageDialog.findComponent("stageNameField").text, id: newStageDialog.findComponent("fileNameField").text });
                            customStageRegistry.set(newStageDialog.findComponent("fileNameField").text, stageToSave._data);

                            stageList.selectedItem = { text: newStageDialog.findComponent("stageNameField").text, id: newStageDialog.findComponent("fileNameField").text };

                            newNotification("Success!", 'Successfully created stage "' + newStageDialog.findComponent("stageNameField").text + '"', NotificationType.Success, 5000);
                        }
                    }

                    cancelInput = false;
                    newStageDialog.hide();
                }
            }

            trace("yo");
        }
        bind(newStageButton, MouseEvent.CLICK, newStageCallback);
        newKeybind(["CONTROL", "N"], newStageCallback);

        var deleteStageButton = menuBar.findComponent("deleteStage");
        deleteStageButton.onClick = ()->{
            if (currentStage.id == "mainStage") {
                newNotification("Error!", 'Could not delete stage!\n"assets" folder is protected.', NotificationType.Error, 5000);
                return;
            }

            var deleteStageCallback = ()->{
                for (mod in PolymodHandler.getAllMods()) {
                    if (FileUtil.directoryExists("mods/" + mod.id + "/data/stages/")) {
                        if (FileUtil.readDir("mods/" + mod.id + "/data/stages/").contains(currentStage.id + ".json")) {
                            var path = "mods/" + mod.id + "/data/stages/" + currentStage.id + ".json";
                            FileUtil.deleteFile(path);
                            
                            newNotification("Success!", 'Successfully deleted stage "' + currentStage.stageName + '"', NotificationType.Success, 5000);
                            
                            blacklist.push(currentStage.stageName);
                            
                            new FlxTimer().start(0.1, ()->{
                                reloadStageList();
                                stageList.selectedItem = { text: "Main Stage", id: "mainStage" };
                            });

                        }
                    }
                }
            }

            if (FlxG.keys.pressed.SHIFT) {
                deleteStageCallback();
            } else {
                var deleteStageDialog = RuntimeComponentBuilder.build(Paths.ui("stage-editor/dialogs/deleteStageDialog"));
                // add(deleteStageDialog);
                deleteStageDialog.screenCenter();
                deleteStageDialog.showDialog(true);
                cancelInput = true;
    
                deleteStageDialog.findComponent("dialogContinue").color = 0xFFFF8888;
                deleteStageDialog.findComponent("dialogContinue").onClick = ()->{
                    cancelInput = false;
                    deleteStageDialog.hide();
                    deleteStageCallback();
                }
    
                deleteStageDialog.findComponent("dialogCancel").color = 0xFFFF8888;
                deleteStageDialog.findComponent("dialogCancel").onClick = ()->{
                    cancelInput = false;
                    deleteStageDialog.hide();
                }
            }

        }

        var exit = ()->{
            FlxG.switchState(new MainMenuState());
            PolymodHandler.forceReloadAssets();
		}

        var exitToMenuItem = menuBar.findComponent("exitToMenu");
        exitToMenuItem.onClick = exit;
        newKeybind(["CONTROL", "Q"], exit);

        saveAsComponent = menuBar.findComponent("saveStageAs");
        //bind(saveAsComponent, MouseEvent.CLICK, test);

        var saveStageComponent = menuBar.findComponent("saveStage");
        var saveStageCallback = ()->{
            if (FlxG.keys.pressed.SHIFT) return;
            /* trace(stringed);
            trace(currentStage.id); */
            if (currentStage.id == "mainStage") {
                newNotification("Error!", 'Could not save stage!\n"assets" folder is protected.', NotificationType.Error, 5000);
                return;
            }
		    for (mod in PolymodHandler.getAllMods()) {
                if (FileUtil.directoryExists("mods/" + mod.id + "/data/stages/")) {
                    if (FileUtil.readDir("mods/" + mod.id + "/data/stages/").contains(currentStage.id + ".json")) {
                        var path = "mods/" + mod.id + "/data/stages/" + currentStage.id + ".json";
		                FileUtil.deleteFile(path);
                        var parsed = Json.parse(currentStage._data.serialize());
                        parsed.directory = "Generated By: " + editorTitle + " v" + editorVersion;
                        parsed.version = "1.0.0";
		                FileUtil.writeStringToPath(path, Json.stringify(parsed, null, "\t"));

                        newNotification("Success!", 'Successfully saved stage to "' + path + '"', NotificationType.Success, 5000);
                        return;
                    }
                }
            }
        }
        //saveStageComponent.onClick = saveStageCallback;
        bind(saveStageComponent, MouseEvent.CLICK, saveStageCallback);
        newKeybind(["CONTROL", "S"], saveStageCallback);
        newKeybind(["CONTROL", "R"], ()->{
            if (!FlxG.keys.pressed.SHIFT) {
                currentStage.resetStage();
                resetChars();
            }
        });

        // nwords <3

        var userGuideCallback = ()->{
            if (cancelInput) return;
            userGuideWindow = RuntimeComponentBuilder.build(Paths.ui("stage-editor/windows/userGuideWindow"));
            userGuideWindow.windowManager = windowManager;
            add(userGuideWindow);
            userGuideWindow.screenCenter();
            cancelInput = true;

            userGuideWindow.findComponent("closeButton").onClick = ()->{
                windowManager.closeWindow(userGuideWindow);
                cancelInput = false;
            }
            
            for (i in ["joinNovaButton", "joinNetworkButton"]) {
                userGuideWindow.findComponent(i).onClick = ()->{
                    FlxG.openURL(userGuideWindow.findComponent(i).tooltip);
                }
            }
        }

        newKeybind(["F1"], userGuideCallback, "justPressed");

        bind(menuBar.findComponent("userGuide"), MouseEvent.CLICK, userGuideCallback);

        stageDataWindow = RuntimeComponentBuilder.build(Paths.ui("stage-editor/windows/stageDataWindow"));
        stageDataWindow.screenCenter();
        stageDataWindow.windowManager = windowManager;
        add(stageDataWindow);

        stageDataWindow.title = "Stage Data";
        stageDataWindow.x = FlxG.width - stageDataWindow.width - 10;
        stageDataWindow.y = menuBar.height + 10;

        stageList = stageDataWindow.findComponent("stageDropdown");
        
        reloadStageList();

        var deletePropButton = stageDataWindow.findComponent("deletePropButton");
        deletePropCallback = ()->{
            if (selectedProp == null) return;
            for (i in currentStage._data.props) {
                if (i.name == selectedProp.name) {
                    currentStage._data.props.remove(i);
                }
            }
            deselectStage();
            refreshPropList();
            reloadStage();
            resetChars();

            propListView.selectedItem = propListView.dataSource.get(propListView.dataSource.size-1);
            propListView.selectedItems = [propListView.dataSource.get(propListView.dataSource.size-1)];
            
            new FlxTimer().start(0.05, ()->{
                propListView.selectedItem = propListView.dataSource.get(propListView.dataSource.size-1);
                propListView.selectedItems = [propListView.dataSource.get(propListView.dataSource.size-1)];
            });
        }
        bind(deletePropButton, MouseEvent.CLICK, deletePropCallback);
        newKeybind(["DELETE"], ()->{
            if (!cancelInput)
                deletePropCallback();
        });


        var newPropButton = stageDataWindow.findComponent("createPropButton");
        var newPropCallback = ()->{
            var proper = templateProp();
            currentStage._data.props.push(proper);
            refreshPropList();
            reloadStage();
            resetChars();
            
            // propListView.selectedItems = [];
            propListView.selectedItem = propListView.dataSource.get(propListView.dataSource.size-1);
            propListView.selectedItems = [propListView.dataSource.get(propListView.dataSource.size-1)];
        }
        bind(newPropButton, MouseEvent.CLICK, newPropCallback);
        // newKeybind(["DELETE"], cancelInput ? 0 : deletePropCallback);


        var editPropButton = stageDataWindow.findComponent("editPropButton");
        editPropCallback = ()->{
            if (selectedProp == null) {
                newNotification("Error!", "Please Select a Prop First.", NotificationType.Error);
            } else {
                cancelInput = true;
                var propData = getSelectedPropData();
                // trace(propData);

                editPropWindow = RuntimeComponentBuilder.build(Paths.ui("stage-editor/windows/editPropWindow"));
                editPropWindow.screenCenter();
                editPropWindow.title = editPropWindow.title.replace("$propID", '"' + propData.name + '"');
                editPropWindow.windowManager = windowManager;
                add(editPropWindow);

                var nameTextField = editPropWindow.findComponent("editPropWindowNameTextField");
                nameTextField.text = propData.name;

                var assetPathTextField = editPropWindow.findComponent("editPropWindowAssetPathTextField");
                assetPathTextField.text = propData.assetPath;

                var colorPicker = editPropWindow.findComponent("editPropWindowColorPicker");
                colorPicker.selectedItem = selectedProp.color;
                colorPicker.onChange = ()->{
                    selectedProp.color = colorPicker.selectedItem;
                    propData.color = FlxColor.toWebString(colorPicker.selectedItem);
                }

                var animationTypeStepper = editPropWindow.findComponent("editPropWindowAnimationStepper");
                animationTypeStepper.onChange = ()->{
                    propData.animType = animationTypeStepper.selectedItem.data;
                }


                var blendModeDropdown = editPropWindow.findComponent("editPropWindowBlendModeDropdown");
                var blends = [
                    "" => { text: "None", data: "-1", id: "" },
                    "add" => { text: "Add", data: "0", id: "" },
                    "alpha" => { text: "Alpha", data: "1", id: "" },
                    "darken" => { text: "Darken", data: "2", id: "" },
                    "difference" => { text: "Difference", data: "3", id: "" },
                    "erase" => { text: "Erase", data: "4", id: "" },
                    "hardlight" => { text: "Hard Light", data: "5", id: "" },
                    "invert" => { text: "Invert", data: "6", id: "" },
                    "layer" => { text: "Layer", data: "7", id: "" },
                    "lighten" => { text: "Lighten", data: "8", id: "" },
                    "multiply" => { text: "Multiply", data: "9", id: "" },
                    "normal" => { text: "Normal", data: "10", id: "" },
                    "overlay" => { text: "Overlay", data: "11", id: "" },
                    "screen" => { text: "Screen", data: "12", id: "" },
                    "shader" => { text: "Shader", data: "13", id: "" },
                    "subtract" => { text: "Subtract", data: "14", id: "" }
                ];
                var item = blends.get(propData.blend);
                item.id = propData.blend;
                blendModeDropdown.selectedItem = item;
                blendModeDropdown.onChange = ()->{
                    propData.blend = blendModeDropdown.selectedItem.id;
                    selectedProp.blend = Std.parseInt(blendModeDropdown.selectedItem.data) != -1 ? Std.parseInt(blendModeDropdown.selectedItem.data) : null;
                }

                var xPosStepper = editPropWindow.findComponent("editPropWindowPosStepperX");
                xPosStepper.pos = Math.round(selectedProp.x);
                xPosStepper.onChange = ()->{
                    propData.position[0] = xPosStepper.pos;
                    selectedProp.x = xPosStepper.pos;
                }

                var yPosStepper = editPropWindow.findComponent("editPropWindowPosStepperY");
                yPosStepper.pos = Math.round(selectedProp.y);
                yPosStepper.onChange = ()->{
                    propData.position[1] = yPosStepper.pos;
                    selectedProp.y = yPosStepper.pos;
                }

                var xScrollPosStepper = editPropWindow.findComponent("editPropWindowScrollStepperX");
                xScrollPosStepper.pos = selectedProp.scrollFactor.x;
                xScrollPosStepper.onChange = ()->{
                    propData.scroll[0] = xScrollPosStepper.pos;
                    selectedProp.scrollFactor.x = xScrollPosStepper.pos;
                }

                var yScrollPosStepper = editPropWindow.findComponent("editPropWindowScrollStepperY");
                yScrollPosStepper.pos = selectedProp.scrollFactor.y;
                yScrollPosStepper.onChange = ()->{
                    propData.scroll[1] = yScrollPosStepper.pos;
                    selectedProp.scrollFactor.y = yScrollPosStepper.pos;
                }

                var scaleStepperX = editPropWindow.findComponent("editPropWindowScaleStepperX");
                scaleStepperX.pos = selectedProp.scale.x;

                var scaleStepperY = editPropWindow.findComponent("editPropWindowScaleStepperY");
                scaleStepperY.pos = selectedProp.scale.y;
                
                scaleStepperX.onChange = ()->{
                    propData.scale = Either.Right([scaleStepperX.pos, scaleStepperY.pos]);
                    selectedProp.scale.set(scaleStepperX.pos, scaleStepperY.pos);
                    selectedProp.updateHitbox();
                }

                scaleStepperY.onChange = ()->{
                    propData.scale = Either.Right([scaleStepperX.pos, scaleStepperY.pos]);
                    selectedProp.scale.set(scaleStepperX.pos, scaleStepperY.pos);
                    selectedProp.updateHitbox();
                }

                var alphaStepper = editPropWindow.findComponent("editPropWindowAlphaStepper");
                alphaStepper.pos = selectedProp.alpha;
                alphaStepper.onChange = ()->{
                    propData.alpha = alphaStepper.pos;
                    selectedProp.alpha = alphaStepper.pos;
                }

                var angleStepper = editPropWindow.findComponent("editPropWindowAngleStepper");
                angleStepper.pos = selectedProp.angle;
                angleStepper.onChange = ()->{
                    if (angleStepper.pos == -1) {
                        angleStepper.pos = 359;
                    } else if (angleStepper.pos == 360) {
                        angleStepper.pos = 0;
                    }
                    propData.angle = angleStepper.pos;
                    selectedProp.angle = angleStepper.pos;
                }

                var danceEveryStepper = editPropWindow.findComponent("editPropWindowDanceStepper");
                danceEveryStepper.pos = propData.danceEvery ?? 0;
                danceEveryStepper.onChange = ()->{
                    propData.danceEvery = danceEveryStepper.pos;
                }

                var zIndexStepper = editPropWindow.findComponent("editPropWindowZIndexStepper");
                zIndexStepper.pos = selectedProp.zIndex;
                zIndexStepper.onChange = ()->{
                    propData.zIndex = zIndexStepper.pos;
                    selectedProp.zIndex = zIndexStepper.pos;
                    currentStage.refresh();
                }

                var flipXCheck = editPropWindow.findComponent("editPropWindowFlipXCheckbox");
                flipXCheck.selected = selectedProp.flipX;
                flipXCheck.onChange = ()->{
                    propData.flipX = flipXCheck.selected;
                    selectedProp.flipX = flipXCheck.selected;
                }

                var flipYCheck = editPropWindow.findComponent("editPropWindowFlipYCheckbox");
                flipYCheck.selected = selectedProp.flipY;
                flipYCheck.onChange = ()->{
                    propData.flipY = flipYCheck.selected;
                    selectedProp.flipY = flipYCheck.selected;
                }

                var isPixelCheck = editPropWindow.findComponent("editPropWindowIsPixelCheckbox");
                isPixelCheck.selected = !selectedProp.antialiasing;
                isPixelCheck.onChange = ()->{
                    propData.isPixel = isPixelCheck.selected;
                    selectedProp.antialiasing = !isPixelCheck.selected;
                }

                var editAnimationButton = editPropWindow.findComponent("editPropWindowAnimationsButton");
                editAnimationCallback = ()->{
                    if (offsetTween != null)
                        offsetTween.cancel();
                    if (!editAnimToggle) {
                        //offsetTween = FlxTween.num(editPropWindowOffset, -390, 1.0, { ease: FlxEase.quartOut }, function(num) { editPropWindowOffset = num; });
                        editPropWindowOffset = -390;
                        
                        editAnimationsWindow = RuntimeComponentBuilder.build(Paths.ui("stage-editor/windows/editPropAnimationWindow"));
                        editAnimationsWindow.windowManager = windowManager;
                        add(editAnimationsWindow);

                        var editAnimationConfirmButton = editAnimationsWindow.findComponent("confirmButton");
                        bind(editAnimationConfirmButton, MouseEvent.CLICK, ()->{
                            offsetTween = FlxTween.num(editPropWindowOffset, 0, 1.0, { ease: FlxEase.quartOut }, function(num) { editPropWindowOffset = num; });
                            windowManager.closeWindow(editAnimationsWindow);
                            editAnimToggle = false;
                            selectedProp.updateHitbox();
                        });

                        var acc1 = editAnimationsWindow.findComponent("ac1");

                        var refreshAnimationList = ()->{

                            var index = 0;
                            for (i in getSelectedPropData().animations) {

                                if (getSelectedPropData().startingAnimation == null && index == 0) {
                                    getSelectedPropData().startingAnimation = i.name;
                                }

                                var animation = RuntimeComponentBuilder.build(Paths.ui("stage-editor/parts/animationPart"));
                                animation.text = i.name;
                                animation.id = i.name;

                                var assetPathTextField = animation.findComponent("editAnimWindowAssetPathTextField");
                                assetPathTextField.text = i.assetPath;
                                assetPathTextField.onChange = ()->{
                                    i.assetPath = assetPathTextField.text;
                                    animation.text = i.assetPath;
                                    // animation.id = i.assetPath;
                                }

                                var nameTextField = animation.findComponent("editAnimWindowAnimNameTextField");
                                nameTextField.text = i.name;
                                nameTextField.onChange = ()->{
                                    i.name = nameTextField.text;
                                    animation.text = i.name;
                                    animation.id = i.name;
                                }

                                var prefixTextField = animation.findComponent("editAnimWindowAnimPrefixTextField");
                                prefixTextField.text = i.prefix;
                                prefixTextField.onChange = ()->{
                                    i.prefix = prefixTextField.text;
                                }

                                var frameIndicesTextField = animation.findComponent("editAnimWindowAnimIndicesTextField");
                                frameIndicesTextField.text = i.frameIndices.join(", ");
                                frameIndicesTextField.onChange = ()->{
                                    frameIndicesTextField.text = frameIndicesTextField.text.replace("  ", " ");
                                    frameIndicesTextField.text = frameIndicesTextField.text.replace(" ,", ",");
                                    frameIndicesTextField.text = frameIndicesTextField.text.replace(",,", ",");
                                    i.frameIndices = stringToIndices(frameIndicesTextField.text);
                                    // i.prefix = frameIndicesTextField.text;
                                }

                                var xOffsetStepper = animation.findComponent("editAnimWindowAnimOffsetXStepper");
                                xOffsetStepper.pos = Math.round(i.offsets[0]);
                                xOffsetStepper.onChange = ()->{
                                    i.offsets[0] = xOffsetStepper.pos;
                                }

                                var yOffsetStepper = animation.findComponent("editAnimWindowAnimOffsetYStepper");
                                yOffsetStepper.pos = Math.round(i.offsets[1]);
                                yOffsetStepper.onChange = ()->{
                                    i.offsets[1] = yOffsetStepper.pos;
                                }

                                var framerateStepper = animation.findComponent("editAnimWindowAnimFrameRateStepper");
                                framerateStepper.pos = i.frameRate;
                                framerateStepper.onChange = ()->{
                                    i.frameRate = framerateStepper.pos;
                                }

                                var flipXCheck = animation.findComponent("editPropWindowFlipXCheckbox");
                                flipXCheck.selected = i.flipX;
                                flipXCheck.onChange = ()->{
                                    i.flipX = flipXCheck.selected;
                                }

                                var flipYCheck = animation.findComponent("editPropWindowFlipYCheckbox");
                                flipYCheck.selected = i.flipY;
                                flipYCheck.onChange = ()->{
                                    i.flipY = flipYCheck.selected;
                                }

                                var loopedCheck = animation.findComponent("editPropWindowLoopedCheckbox");
                                loopedCheck.selected = i.looped;
                                loopedCheck.onChange = ()->{
                                    i.looped = loopedCheck.selected;
                                }

                                var isDefaultCheck = animation.findComponent("editPropWindowIsDefaultCheckbox");
                                isDefaultCheck.selected = getSelectedPropData().startingAnimation == i.name;
                                isDefaultCheck.onClick = ()->{
                                    getSelectedPropData().startingAnimation = isDefaultCheck.selected ? i.name : null;
                                    for (i2 in getSelectedPropData().animations) {
                                        acc1.findComponent(i2.name).findComponent("editPropWindowIsDefaultCheckbox").selected = getSelectedPropData().startingAnimation == i2.name;
                                    }
                                    selectedProp.animation.play(getSelectedPropData().startingAnimation, true);
                                }

                                acc1.addComponent(animation);
                                
                                index++;
                            }
                        }
                        refreshAnimationList();

                        var newAnimationButton = editAnimationsWindow.findComponent("newAnimation");
                        newAnimationButton.onClick = ()->{
                            getSelectedPropData().animations.push(templateAnimation());
                            windowManager.closeWindow(editAnimationsWindow);
                            editAnimToggle = false;
                            editAnimationCallback();
                        }

                        var deleteAnimationButton = editAnimationsWindow.findComponent("deleteAnimation");
                        deleteAnimationButton.onClick = ()->{
                            for (i in getSelectedPropData().animations) {
                                if (i.name == acc1.selectedPage.id) {
                                    getSelectedPropData().animations.remove(i);
                                    windowManager.closeWindow(editAnimationsWindow);
                                    editAnimToggle = false;
                                    editAnimationCallback();
                                    
                                }
                            }
                        }
                    } else {
                        offsetTween = FlxTween.num(editPropWindowOffset, 0, 1.0, { ease: FlxEase.quartOut }, function(num) { editPropWindowOffset = num; });
                        windowManager.closeWindow(editAnimationsWindow);
                    }
                    editAnimToggle = !editAnimToggle;
                }
                bind(editAnimationButton, MouseEvent.CLICK, editAnimationCallback);

                var editConfirmButton = editPropWindow.findComponent("editPropWindowConfirm");
                bind(editConfirmButton, MouseEvent.CLICK, ()->{
                    if (nameTextField.text == "") {
                        newNotification("Error!", '"Prop Name" must not be blank.', NotificationType.Error);
                    }
                    if (assetPathTextField.text == "") {
                        newNotification("Error!", '"Asset Path" must not be blank.', NotificationType.Error);
                    }
                    if (nameTextField.text != "" && assetPathTextField.text != "" && checkImageExists(assetPathTextField.text)) {
                        cancelInput = false;
                        windowManager.closeWindow(editPropWindow);
                        if (editAnimationsWindow != null)
                            windowManager.closeWindow(editAnimationsWindow);
                        propData.name = nameTextField.text;
                        propData.assetPath = assetPathTextField.text;
                        reloadStage();
                        // deselectStage();
                        deselectChars();
                        refreshPropList();
                        resetChars();
                        editAnimToggle = false;
                        FlxTween.num(editPropWindowOffset, 0, 1.0, { ease: FlxEase.quartOut }, function(num) { editPropWindowOffset = num; });
                        propListViewCallback();
                    } else if (!checkImageExists(assetPathTextField.text)) {
                        FlxTween.color(assetPathTextField, 1.0, FlxColor.RED, FlxColor.WHITE);
                        newNotification("Error!", '"Asset Path" is not valid.', NotificationType.Error);
                    }
                });
            }
        }
        bind(editPropButton, MouseEvent.CLICK, editPropCallback);    

        var playerDropdown = stageDataWindow.findComponent("playerDropdown");
        var opponentDropdown = stageDataWindow.findComponent("opponentDropdown");
        var spectatorDropdown = stageDataWindow.findComponent("spectatorDropdown");
        for (i in nameList) {
            playerDropdown.dataSource.add({text: i});
            opponentDropdown.dataSource.add({text: i});
            spectatorDropdown.dataSource.add({text: i});
        }

        playerDropdown.onChange = ()->{
            currentStage.getBoyfriend(true);
            for (i in CharacterDataParser.characterCache.keys()) {
                if (CharacterDataParser.characterCache.get(i).name == playerDropdown.selectedItem.text) {
                    player = CharacterDataParser.fetchCharacter(i);
                    player.debug = true;
                    resetChars();
                    break;
                }
            }
            deselectChars();
            deselectStage();
            resetChars();
        }

        opponentDropdown.onChange = ()->{
            currentStage.getDad(true);
            for (i in CharacterDataParser.characterCache.keys()) {
                if (CharacterDataParser.characterCache.get(i).name == opponentDropdown.selectedItem.text) {
                    opponent = CharacterDataParser.fetchCharacter(i);
                    opponent.debug = true;
                    resetChars();
                    break;
                }
            }
            deselectChars();
            deselectStage();
            resetChars();
        }

        spectatorDropdown.onChange = ()->{
            currentStage.getGirlfriend(true);
            for (i in CharacterDataParser.characterCache.keys()) {
                if (CharacterDataParser.characterCache.get(i).name == spectatorDropdown.selectedItem.text) {
                    spectator = CharacterDataParser.fetchCharacter(i);
                    spectator.debug = true;
                    resetChars();
                    break;
                }
            }
            deselectChars();
            deselectStage();
            resetChars();
        }


        /* var propListView = stageDataWindow.findComponent("propsListView");
        propListView.onDataChanged = (data) -> {
            trace(data);
        } */
        
        propListView = stageDataWindow.findComponent("propsListView");
        characterListView = stageDataWindow.findComponent("charactersListView");

        deselectStage = function(?target:Float) {
            target ??= 1;
            propListView.selectedItems = [];
            propListView.selectedItem = null;
            selectedProp = null;
            var index = 0;
            for (i in currentStage.members) {
                var isProp = false;
                for (prop in currentStage._data.props) {
                    if (prop?.name == i?.name)
                        isProp = true;
                }
                if (isProp) {
                    // i?.color = target == 1 ? FlxColor.fromWebString(currentStage?._data?.props[index]?.color ?? "#FFFFFF") : 0xFF111111;
                    i?.alpha = target ?? currentStage?._data?.props[index]?.alpha ?? 1;
                }

                if (player != null) 
                    player.alpha = (player._data.alpha ?? 1) * (target ?? 1);

                if (opponent != null)
                    opponent.alpha = (opponent._data.alpha ?? 1) * (target ?? 1);

                if (spectator != null)
                    spectator.alpha = (spectator._data.alpha ?? 1) * (target ?? 1);

                index++;
            }
        };

        deselectChars = ()->{
            characterListView.selectedItems = [];
            selectedCharacter = null;
            selectedCharacterType = "none";
            /* selectedProp = null;
            for (i in currentStage.members) {
                i.alpha = 1;
            } */
        };

        characterListView.onChange = characterListViewCallback = ()->{
            deselectStage(0.5);
            switch (characterListView.selectedItem.text) {
                case "Player":
                    if (player != null) {
                        player.alpha = (player._data.alpha ?? 1);
                        selectedCharacter = player;
                        selectedCharacterType = "bf";
                    } else {
                        deselectChars();
                        deselectStage();
                    }
                case "Opponent":
                    if (opponent != null) {
                        opponent.alpha = (opponent._data.alpha ?? 1);
                        selectedCharacter = opponent;
                        selectedCharacterType = "dad";
                    } else {
                        deselectChars();
                        deselectStage();
                    }
                case "Spectator":
                    if (spectator != null) {
                        spectator.alpha = (spectator._data.alpha ?? 1);
                        selectedCharacter = spectator;
                        selectedCharacterType = "gf";
                    } else {
                        deselectChars();
                        deselectStage();
                    }
            }
        }

        propListView.onClick = ()->{
            clickIndex++;
            if (doubleClickTween != null)
                doubleClickTween.cancel();
            doubleClickTween = new FlxTimer().start(0.25, ()->{
                clickIndex = 0;
            });
            if (clickIndex == 2) {
                if (selectedProp != null) {
                    editPropCallback();
                }
            }
        }

        propListView.onChange = propListViewCallback = ()->{
            /* xLine.scrollFactor.y = currentStage.getNamedProp(propListView.selectedItem.text).scrollFactor.y;
            yLine.scrollFactor.x = currentStage.getNamedProp(propListView.selectedItem.text).scrollFactor.x; */
            selectedProp = currentStage.getNamedProp(propListView.selectedItem.text);

            currentStage.forEachAlive((i)->{
                if (i.name == opponent.name || i.name == player.name || i.name == spectator.name) {
                    i.alpha = switch (i.name) {
                        case player.name:
                            currentStage._data.characters.bf?.alpha ?? 1;
                        case opponent.name:
                            currentStage._data.characters.dad?.alpha ?? 1;
                        case spectator.name:
                            currentStage._data.characters.gf?.alpha ?? 1;
                    }
                } else {
                    i.alpha = getSelectedPropData().alpha;
                }
            });
            deselectChars();
            // clickIndex = 0;
            // doubleClickTimer = 0;
            /* if (doubleClickTween != null)
                doubleClickTween.cancel(); */
        }

        newKeybind(["ESCAPE"],  ()->{
            deselectStage();
            deselectChars();
        });

        stageList.onChange = ()->{
            if (stageList.selectedItem.id == null) return;
            history = [];
            redoHistory = [];
            if (members.contains(currentStage)) {
                remove(currentStage);
            }
            currentStage = new Stage('mainStage');
            currentStage._cameras = [camGame];
            currentStage.onCreate();
            currentStage._data = customStageRegistry.get(stageList.selectedItem.id);
            currentStage.id = stageList.selectedItem.id;
            // trace(customStageRegistry.get(stageList.selectedItem.id));
            reloadStage();
            insert(0, currentStage);

            refreshPropList();

            stageDataWindow.findComponent("stageNameTextField").text = stageList.selectedItem.text;
            stageDataWindow.findComponent("defualtCamZoomStepper").pos = currentStage.camZoom;
            FlxTween.tween(camGame, { zoom: currentStage.camZoom }, 0.25, { ease: FlxEase.quartOut });
            FlxTween.tween(camGame.scroll, { x: -FlxG.width/2, y: -FlxG.height/2 }, 0.25, { ease: FlxEase.quartOut });
            deselectStage();
            deselectChars();
            resetChars();
        }

        var stageNameTextField = stageDataWindow.findComponent("stageNameTextField");
        stageNameTextField.onChange = ()->{
            if (currentStage == null) return;
            
            currentStage._data.name = stageNameTextField.text;
            //currentStage.name = stageNameTextField.text;
            stageList.text = stageNameTextField.text;
            stageList.selectedItem.text = stageNameTextField.text;
            
        }

        var zoomStepper = stageDataWindow.findComponent("defualtCamZoomStepper");
        zoomStepper.onChange = ()->{
            if (currentStage == null) return; 
            currentStage._data.cameraZoom = zoomStepper.pos;
            // currentStage.camZoom = zoomStepper.pos;
        }

        stageList.selectedItem = { text: "Main Stage" };
        
        /* editPropWindow = RuntimeComponentBuilder.build(Paths.ui("stage-editor/windows/editPropAnimationWindow"));
        editPropWindow.windowManager = windowManager; */
        // add(editPropWindow);

        initNotification();

        newKeybind(["W"], (elapsed) -> !cancelInput ? camGame.scroll.y -= ((FlxG.keys.pressed.SHIFT ? 10 : !FlxG.keys.pressed.CONTROL ? 5 : 0) * elapsed) * 75 : 0, "pressed");
        newKeybind(["A"], (elapsed) -> !cancelInput ? camGame.scroll.x -= ((FlxG.keys.pressed.SHIFT ? 10 : !FlxG.keys.pressed.CONTROL ? 5 : 0) * elapsed) * 75 : 0, "pressed");
        newKeybind(["S"], (elapsed) -> !cancelInput ? camGame.scroll.y += ((FlxG.keys.pressed.SHIFT ? 10 : !FlxG.keys.pressed.CONTROL ? 5 : 0) * elapsed) * 75 : 0, "pressed");
        newKeybind(["D"], (elapsed) -> !cancelInput ? camGame.scroll.x += ((FlxG.keys.pressed.SHIFT ? 10 : !FlxG.keys.pressed.CONTROL ? 5 : 0) * elapsed) * 75 : 0, "pressed");

        newKeybind(["Q"], (elapsed) -> (!cancelInput && !FlxG.keys.pressed.CONTROL) ? camGame.zoom -= (0.015 * elapsed) * 100 : 0, "pressed");
        newKeybind(["E"], (elapsed) -> (!cancelInput && !FlxG.keys.pressed.CONTROL) ? camGame.zoom += (0.015 * elapsed) * 100 : 0, "pressed");

        newKeybind(["CONTROL", "E"], ()->camHUD.visible = !camHUD.visible);

        camGame.scroll.x = -FlxG.width/2;
        camGame.scroll.y = -FlxG.height/2;

        
        yLine = new FunkinSprite(0, 0).makeGraphic(1, 1, 0xFF00FF00);
        yLine.scale.y = 2000;
        yLine.antialiasing = true;
        yLine.cameras = [camGame];
        yLine.alpha = 0.5;
        add(yLine);

        xLine = new FunkinSprite(0, 0).makeGraphic(1, 1, 0xFFFF0000);
        xLine.antialiasing = true;
        xLine.cameras = [camGame];
        xLine.alpha = 0.5;
        add(xLine);

        var index = 0;
        for (i in ["(-x, -y)", "(+x, -y)", "(-x, +y)", "(+x, +y)"]) {
            var negativePositive = new FlxText(0, 0, null, i);
            negativePositive.antialiasing = false;
            negativePositive.updateHitbox();
            switch (index) {
                case 0:
                    negativePositive.x -= negativePositive.width;
                    negativePositive.y -= negativePositive.height;
                case 1:
                    // negativePositive.x += negativePositive.width;
                    negativePositive.y -= negativePositive.height;
                case 2:
                    negativePositive.x -= negativePositive.width;
                    // negativePositive.y += negativePositive.height;
                case 3:
                    // negativePositive.x += negativePositive.width;
                    // negativePositive.y += negativePositive.height;

            }
            negativePositive.cameras = [camGame];
            np.push(negativePositive);
            add(negativePositive);
            index++;
        }

        var editCharacterButton = stageDataWindow.findComponent("editCharacterButton");
        editCharacterButton.onClick = ()->{
            if (selectedCharacter == null) {
                newNotification("Error!", "Please Select a Character First.", NotificationType.Error);
                return;
            }
            editCharacterWindow = RuntimeComponentBuilder.build(Paths.ui("stage-editor/windows/editCharacterWindow"));
            editCharacterWindow.windowManager = windowManager;
            editCharacterWindow.title = "Editing " + switch (selectedCharacterType) {
                case "bf":
                    "Player";
                case "gf":
                    "Spectator";
                case "dad":
                    "Opponent";
            }
            
            add(editCharacterWindow);
            cancelInput = true;

            //hasCharacterEditorInstalled = false;
            editCharacterWindow.findComponent("editCharaterWindowOpenEditor").disabled = !hasCharacterEditorInstalled;
            if (!hasCharacterEditorInstalled) {
                editCharacterWindow.findComponent("editorBox").tooltip = "Nova Character Editor is Not Installed";
            } else {
                editCharacterWindow.findComponent("editCharaterWindowOpenEditor").onClick = ()->{
                    var char; 
                    switch (selectedCharacterType) {
                        case "bf":
                            char = player;
                        case "gf":
                            char = spectator;
                        case "dad":
                            char = opponent;
                    }
                    
                    for (i in CharacterDataParser.characterCache.keys()) {
                        if (CharacterDataParser.characterCache.get(i).name == char.name) {
                            CharacterEditorV3.startingChar = { text: char.name, id: i, protected: false };
                        }
                    }

                    CharacterEditorV3.skipPreloading = true;
                    FlxG.switchState(ScriptedMusicBeatState.init('CharacterEditorV3'));
                }
            }


            var editConfirmButton = editCharacterWindow.findComponent("editCharacterWindowConfirm");
            bind(editConfirmButton, MouseEvent.CLICK, ()->{
                cancelInput = false;
                windowManager.closeWindow(editCharacterWindow);
                deselectStage();
                // deselectChars();
                resetChars();
                forceUpdateBounds = true;
                characterListViewCallback();
            });


            var getCharData = ()->{
                switch (selectedCharacterType) {
                    case "bf":
                        return currentStage._data.characters.bf;
                    case "gf":
                        return currentStage._data.characters.gf;
                    case "dad":
                        return currentStage._data.characters.dad;
                }
            }

            xPosStepper = editCharacterWindow.findComponent("editCharacterWindowPosStepperX");
            xPosStepper.pos = getCharData().position[0];
            xPosStepper.onChange = ()->{
                getCharData().position[0] = xPosStepper.pos;
                resetChars();
            }

            yPosStepper = editCharacterWindow.findComponent("editCharacterWindowPosStepperY");
            yPosStepper.pos = getCharData().position[1];
            yPosStepper.onChange = ()->{
                getCharData().position[1] = yPosStepper.pos;
                resetChars();
            }

            xCamPosStepper = editCharacterWindow.findComponent("charCamOffsetX");
            xCamPosStepper.pos = getCharData().cameraOffsets[0];
            xCamPosStepper.onChange = ()->{
                getCharData().cameraOffsets[0] = xCamPosStepper.pos;
                resetChars();
            }

            yCamPosStepper = editCharacterWindow.findComponent("charCamOffsetY");
            yCamPosStepper.pos = getCharData().cameraOffsets[1];
            yCamPosStepper.onChange = ()->{
                getCharData().cameraOffsets[1] = yCamPosStepper.pos;
                resetChars();
            }

            xScrollPosStepper = editCharacterWindow.findComponent("editCharacterWindowScrollStepperX");
            xScrollPosStepper.pos = getCharData().scroll[0];
            xScrollPosStepper.onChange = ()->{
                getCharData().scroll[0] = xScrollPosStepper.pos;
                resetChars();
            }

            yScrollPosStepper = editCharacterWindow.findComponent("editCharacterWindowScrollStepperY");
            yScrollPosStepper.pos = getCharData().scroll[1];
            yScrollPosStepper.onChange = ()->{
                getCharData().scroll[1] = yScrollPosStepper.pos;
                resetChars();
            }

            scaleStepper = editCharacterWindow.findComponent("editCharacterWindowScaleStepper");
            scaleStepper.pos = getCharData().scale;
            scaleStepper.onChange = ()->{
                getCharData().scale = scaleStepper.pos;
                resetChars();
            }

            alphaStepper = editCharacterWindow.findComponent("editCharacterWindowAlphaStepper");
            alphaStepper.pos = getCharData().alpha;
            alphaStepper.onChange = ()->{
                getCharData().alpha = alphaStepper.pos;
                resetChars();
            }

            angleStepper = editCharacterWindow.findComponent("editCharacterWindowAngleStepper");
            angleStepper.pos = getCharData().angle;
            angleStepper.onChange = ()->{
                getCharData().angle = angleStepper.pos;
                resetChars();
            }

            zIndexStepper = editCharacterWindow.findComponent("editCharacterWindowZIndexStepper");
            zIndexStepper.pos = getCharData().zIndex;
            zIndexStepper.onChange = ()->{
                getCharData().zIndex = zIndexStepper.pos;
                resetChars();
            }

            visibleCheck = editCharacterWindow.findComponent("editCharacterWindowVisibleCheckbox");
            visibleCheck.selected = switch (selectedCharacterType) {
                case "bf":
                    player.visible;
                case "gf":
                    spectator.visible;
                case "dad":
                    opponent.visible;
            }
            visibleCheck.onChange = ()->{
                switch (selectedCharacterType) {
                    case "bf":
                        player.visible = visibleCheck.selected;
                    case "gf":
                        spectator.visible = visibleCheck.selected;
                    case "dad":
                        opponent.visible = visibleCheck.selected;
                }
                resetChars();
            }
        }

        var musicSlider = menuBar.findComponent("menubarItemVolumeInstrumental");
        musicSlider.onChange = ()->{
            FlxG.sound.music.volume = musicSlider.pos/100;
            menuBar.findComponent("editorMusicVolume").text = "Editor Music - " + Math.round(musicSlider.pos) + "%";
        }

        var musicMenu = menuBar.findComponent("musicMenu");
        musicMenu.dataSource.add({text: "Freaky Menu", id: "freakyMenu"});
        
        var folders = [
            "assets/shared/music/",
            "assets/music/"
        ];
        for (mod in PolymodHandler.getAllMods()) {
            if (FileUtil.directoryExists("mods/" + mod.id + "/music/")) {
                folders.push("mods/" + mod.id + "/music/");
            }
        }
        for (folder in folders) {
            for (file in FileUtil.readDir(folder)) {
                if (file.endsWith(".ogg") || file == "credits" || file == "freakyMenu" || file == "gameplay") continue;
                var name;
                if (FileUtil.fileExists(folder + file + "/" + file + "-metadata.json")) {
                    name = Json.parse(FileUtil.readStringFromPath(folder + file + "/" + file + "-metadata.json")).songName;
                } else {
                    name = file;
                }
                musicMenu.dataSource.add({text: name, id: file});
                musicMenu.onChange = ()->{
                    save.data.editorSong = {
                        title: musicMenu.selectedItem.text,
                        key: musicMenu.selectedItem.id
                    }
                    FunkinSound.playMusic(musicMenu.selectedItem.id, {startingVolume: 1, overrideExisting: true, restartTrack: false, persist: true, loop: true});
                    
                    // FlxG.sound.music.fadeIn(0.5, 0, 1);
                }
                /* var thing = new MenuItem();
                thing.text = name;
                thing.id = file;
                thing.onClick = ()->{
                    FunkinSound.playMusic(file, {startingVolume: 0, overrideExisting: true, restartTrack: false, persist: true, loop: true});
                    FlxG.sound.music.fadeIn(0.5, 0, 1);
                } */
    
                //musicMenu.addComponent(thing);
            }
        }

        playerDropdown.selectedItem = { text: "Boyfriend" };
