                editCharacterWindow.findComponent("editorBox").tooltip = "Nova Character Editor is Not Installed";
            } else {
                editCharacterWindow.findComponent("editCharaterWindowOpenEditor").onClick = ()->{
                    var char;
                    switch (selectedCharacterType) {
                        case "bf":
