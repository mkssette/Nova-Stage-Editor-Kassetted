    function reloadStage() {
        var i = currentStage.members.length - 1;
        while (i >= 0) {
            var member = currentStage.members[i];
            if (member != null) {
                if (member == player || member == opponent || member == spectator) {
                    currentStage.remove(member, true);
                } else {
                    member.destroy(); 
                    currentStage.remove(member, true);
                }
            }
            i--;
        }

        currentStage.buildStage();
        
        
        for (i in currentStage._data.props) {
            trace(i.scale);
        }
        
        currentStage.refresh();

        DiscordClient.setPresence({
            details: editorTitle + " v" + editorVersion,
            state: 'Editing a Stage: ' + currentStage.stageName,
        });

    }

    var targetSpriteY = 0;

    var mouseLock = {
        x: 0,
        y: 0
    }

    var forceUpdateBounds = false;

    var focusTimer = 0;

    var iTime = 0;

    function update(elapsed) {
        super.update(elapsed);

        var currentWorldPos = FlxG.mouse.getWorldPosition(camGame);
        mouseWorldDeltaX = currentWorldPos.x - lastMouseWorldX;
        mouseWorldDeltaY = currentWorldPos.y - lastMouseWorldY;
        lastMouseWorldX = currentWorldPos.x;
        lastMouseWorldY = currentWorldPos.y;

        if (FlxG.mouse.justPressed && rightClickMenu != null && !FlxG.mouse.overlaps(rightClickMenu))
		{
			rightClickMenu.destroy();
			rightClickMenu = null;
		}

        if (focusTimer > 0) {
            focusTimer--;
            return;
        }

        get_conductorInUse().update();

        for (i in 0...propListView.dataSource.size) {
            var item = propListView.dataSource.get(i);
            if (currentStage.getNamedProp(item.text) == null) continue;
            currentStage.getNamedProp(item.text).visible = item.visible;
        }

        StageEditorHistory.updateHistory(this);

        if (FlxG.keys.pressed.CONTROL && FlxG.keys.justPressed.Y) StageEditorHistory.redoCallback(this);
        if (FlxG.keys.pressed.CONTROL && FlxG.keys.justPressed.Z) StageEditorHistory.undoCallback(this);


        for (i in 0...characterListView.dataSource.size) {
            var item = characterListView.dataSource.get(i);
            switch (item.text) {
                case "Player":
                    player.visible = item.visible;
                case "Opponent":
                    opponent.visible = item.visible;
                case "Spectator":
                    spectator.visible = item.visible;
            }
        }

        iTime += elapsed;
        


        

        


        if (editAnimationsWindow != null && editPropWindow != null) {
            editAnimationsWindow.height = editPropWindow.height;
        }

        if (FlxG.mouse.justPressed) {
            FlxG.sound.play(Paths.sound("click"));
            
        }

        for (keybind in keybinds) {
            var pressed = true;
            var index = 0;
            
            for (key in keybind.keys) {
                if (index == keybind.keys.length - 1 && keybind.type != "pressed") {
                    if (!Reflect.getProperty(FlxG.keys.justPressed, key)) {
                        pressed = false;
                    }
                } else {
                    if (!Reflect.getProperty(FlxG.keys.pressed, key)) {
                        pressed = false;
                    }
                }
                index++;
            }
            if (pressed) {
                keybind.action(elapsed);
            }
        }

        if (camGame.zoom < 0.01) {
            camGame.zoom = 0.01;
        }

        updateTransformTool();

        if (!cancelInput && !FlxG.mouse.overlaps(stageDataWindow) && !FlxG.mouse.overlaps(menuBar)) {
            var scrollSpeed = 700 * elapsed / camGame.zoom;
            var margin = 25;
            if (FlxG.mouse.screenX > 2 && FlxG.mouse.screenX < margin) {
                camGame.scroll.x -= scrollSpeed;
            } else if (FlxG.mouse.screenX < FlxG.width - 2 && FlxG.mouse.screenX > FlxG.width - margin) {
                camGame.scroll.x += scrollSpeed;
            }
            if (FlxG.mouse.screenY > 2 && FlxG.mouse.screenY < margin + (menuBar != null ? menuBar.height : 0)) {
                camGame.scroll.y -= scrollSpeed;
            } else if (FlxG.mouse.screenY < FlxG.height - 2 && FlxG.mouse.screenY > FlxG.height - margin) {
                camGame.scroll.y += scrollSpeed;
            }
        }
        if (!cancelInput) {
            if (FlxG.mouse.wheel != 0 && !FlxG.mouse.overlaps(stageDataWindow)) {
                camGame.zoom += FlxG.mouse.wheel/10;
            }
        }

        var npIndex = 0;
        for (negativePositive in np) {
            negativePositive.x = 0;
            negativePositive.y = 0;
            negativePositive.alpha = camHUD.visible ? xLine.alpha : 0;
            negativePositive.scale.set(2/camGame.zoom, 2/camGame.zoom);
            negativePositive.antialiasing = false;
            negativePositive.updateHitbox();
            switch (npIndex) {
                case 0:
                    negativePositive.x -= negativePositive.width + (10/camGame.zoom);
                    negativePositive.y -= negativePositive.height + (10/camGame.zoom);
                case 1:
                    negativePositive.x += (10/camGame.zoom);
                    negativePositive.y -= negativePositive.height + (10/camGame.zoom);
                case 2:
                    negativePositive.x -= negativePositive.width + (10/camGame.zoom);
                    negativePositive.y += (10/camGame.zoom);
                case 3:
                    negativePositive.x += (10/camGame.zoom);
                    negativePositive.y += (10/camGame.zoom);
            }
            npIndex++;
        }

        if (selectedProp == null || (!FlxG.mouse.overlaps(selectedProp, camGame) && !usingTransformTool())) updateTransformTool();

        yLine.scale.x = 2 / camGame.zoom;
        yLine.scale.y = FlxG.height * (1/camGame.zoom) * 2;
        yLine.screenCenter();
        yLine.updateHitbox();
        yLine.x = -yLine.width/2;
        yLine.scrollFactor.y = 0;
        yLine.visible = camHUD.visible;

        xLine.scale.y = 2 / camGame.zoom;
        xLine.scale.x = FlxG.width * (1/camGame.zoom) * 2;
        xLine.screenCenter();
        xLine.updateHitbox();
        xLine.y = -xLine.height/2;
        xLine.scrollFactor.x = 0;
        xLine.visible = camHUD.visible;

        playerBoundingBox.alpha = opponentBoundingBox.alpha = spectatorBoundingBox.alpha = camHUD.visible ? (!FlxG.keys.pressed.Q && !FlxG.keys.pressed.E ? 1 : 0) : 0;

        if ((!FlxG.keys.pressed.Q && !FlxG.keys.pressed.E) || forceUpdateBounds) {


            

            if ((playerBoundingBox.lineStyle.thickness != 2 / camGame.zoom || forceUpdateBounds) && playerBoundingBox.visible) {
                playerBoundingBox.lineStyle.thickness = 2 / camGame.zoom;
                playerBoundingBox.redrawShape();
                playerBoundingBox.shapeWidth = FlxG.width / currentStage._data.cameraZoom;
                playerBoundingBox.shapeHeight = FlxG.height / currentStage._data.cameraZoom;
                playerBoundingBox.updateHitbox();
                playerBoundingBox.x = player.cameraFocusPoint.x - (playerBoundingBox.width/2) + currentStage._data.characters.bf.cameraOffsets[0] + 2;
                playerBoundingBox.y = player.cameraFocusPoint.y - (playerBoundingBox.height/2) + currentStage._data.characters.bf.cameraOffsets[1] + 2;
            }

            if ((opponentBoundingBox.lineStyle.thickness != 2 / camGame.zoom || forceUpdateBounds) && opponentBoundingBox.visible) {
                opponentBoundingBox.lineStyle.thickness = 2 / camGame.zoom;
                opponentBoundingBox.redrawShape();
                opponentBoundingBox.shapeWidth = FlxG.width / currentStage._data.cameraZoom;
                opponentBoundingBox.shapeHeight = FlxG.height / currentStage._data.cameraZoom;
                opponentBoundingBox.updateHitbox();
                opponentBoundingBox.x = opponent.cameraFocusPoint.x - (opponentBoundingBox.width/2) + currentStage._data.characters.dad.cameraOffsets[0] + 2;
                opponentBoundingBox.y = opponent.cameraFocusPoint.y - (opponentBoundingBox.height/2) + currentStage._data.characters.dad.cameraOffsets[1] + 2;
            }

            if ((spectatorBoundingBox.lineStyle.thickness != 2 / camGame.zoom || forceUpdateBounds) && spectatorBoundingBox.visible) {
                spectatorBoundingBox.lineStyle.thickness = 2 / camGame.zoom;
                spectatorBoundingBox.redrawShape();
                spectatorBoundingBox.shapeWidth = FlxG.width / currentStage._data.cameraZoom;
                spectatorBoundingBox.shapeHeight = FlxG.height / currentStage._data.cameraZoom;
                spectatorBoundingBox.updateHitbox();
                spectatorBoundingBox.x = spectator.cameraFocusPoint.x - (spectatorBoundingBox.width/2) + currentStage._data.characters.gf.cameraOffsets[0] + 2;
                spectatorBoundingBox.y = spectator.cameraFocusPoint.y - (spectatorBoundingBox.height/2) + currentStage._data.characters.gf.cameraOffsets[1] + 2;
            }
        }

        forceUpdateBounds = false;

        if (selectedProp != null  && !cancelInput) {
            for (i in currentStage._data.props) {
                if (i.name == selectedProp.name) {
                    i.position[0] = Math.round(selectedProp.x);
                    i.position[1] = Math.round(selectedProp.y);
                }
            }
            
        }

        if (FlxG.mouse.justReleased) draggingHandle = null;

        if (selectedCharacter != null && !cancelInput) {
            if (FlxG.mouse.overlaps(selectedCharacter, camGame) && FlxG.mouse.justPressed) draggingHandle = "character";
            
            if ((FlxG.mouse.overlaps(selectedCharacter, camGame) && FlxG.mouse.pressed && draggingHandle == null) || (draggingHandle == "character" && FlxG.mouse.pressed)) {
                draggingHandle = "character";
                selectedCharacter.x += FlxG.mouse.deltaX / camGame.zoom;
                selectedCharacter.y += FlxG.mouse.deltaY / camGame.zoom;

                switch (selectedCharacterType) {
                    case "bf":
                        currentStage._data.characters.bf.position[0] = Math.round(selectedCharacter.x) + selectedCharacter.characterOrigin.x;
                        currentStage._data.characters.bf.position[1] = Math.round(selectedCharacter.y) + selectedCharacter.characterOrigin.y;
                    case "gf":
                        currentStage._data.characters.gf.position[0] = Math.round(selectedCharacter.x) + selectedCharacter.characterOrigin.x;
                        currentStage._data.characters.gf.position[1] = Math.round(selectedCharacter.y) + selectedCharacter.characterOrigin.y;
                    case "dad":
                        currentStage._data.characters.dad.position[0] = Math.round(selectedCharacter.x) + selectedCharacter.characterOrigin.x;
                        currentStage._data.characters.dad.position[1] = Math.round(selectedCharacter.y) + selectedCharacter.characterOrigin.y;
                }
            }
        }

        if (FlxG.mouse.justPressedRight && selectedProp != null && FlxG.mouse.overlaps(selectedProp, camGame)) {
            if (rightClickMenu != null)
			{
				rightClickMenu.destroy();
				rightClickMenu = null;
			}
            rightClickMenu = RuntimeComponentBuilder.build(Paths.ui("stage-editor/rightClick/prop"));
            rightClickMenu.x = FlxG.mouse.x;
            rightClickMenu.y = FlxG.mouse.y;
            rightClickMenu.cameras = [camInteract];
            add(rightClickMenu);

            duplicatePropCallback = ()->{
                var proper = Reflect.copy(getSelectedPropData());
                var properCount = 1;
                for (i in currentStage._data.props) {
                    if (i.name.startsWith(proper.name)) properCount++;
                }
                proper.name = proper.name + " (" + properCount + ")";
                currentStage._data.props.push(proper);
                refreshPropList();
                reloadStage();
                resetChars();

                
                propListView.selectedItem = propListView.dataSource.get(propListView.dataSource.size-1);
                propListView.selectedItems = [propListView.dataSource.get(propListView.dataSource.size-1)];
            }

            bind(rightClickMenu.findComponent("edit"), MouseEvent.CLICK, editPropCallback);
            bind(rightClickMenu.findComponent("delete"), MouseEvent.CLICK, deletePropCallback);
            
        }

    }

    function usingTransformTool() {
        if (draggingHandle != null) return true;
        return FlxG.mouse.overlaps(cC, camGame) || FlxG.mouse.overlaps(tLC, camGame) || FlxG.mouse.overlaps(tMC, camGame) || FlxG.mouse.overlaps(tRC, camGame) || FlxG.mouse.overlaps(mRC, camGame) || FlxG.mouse.overlaps(bRC, camGame) || FlxG.mouse.overlaps(bMC, camGame) || FlxG.mouse.overlaps(bLC, camGame) || FlxG.mouse.overlaps(mLC, camGame);
    }

    
    function updateTransformHandle(sprite:FunkinSprite, x:Float, y:Float, mouseDeltaX:Float, mouseDeltaY:Float, invZoom:Float, isSmall:Bool = false, ?handleID:String = null) {
        if (sprite == null) return;
        
        var s = isSmall ? (0.9 * invZoom) : invZoom;
        
        if (sprite.scale.x != s || sprite.scale.y != s) {
            sprite.scale.set(s, s);
            sprite.updateHitbox();
        }

        if (selectedProp != null && (sprite.scrollFactor.x != selectedProp.scrollFactor.x || sprite.scrollFactor.y != selectedProp.scrollFactor.y)) {
             sprite.scrollFactor.set(selectedProp.scrollFactor.x, selectedProp.scrollFactor.y);
        }

        sprite.x = x; 
        sprite.y = y;

        var isOverlapping = FlxG.mouse.overlaps(sprite, camGame);
        var isDraggingThis = handleID != null && draggingHandle == handleID;
        sprite.alpha = isOverlapping || isDraggingThis ? (FlxG.mouse.pressed ? 1 : 0.75) : 0.5;

        if (FlxG.mouse.pressed && (isOverlapping || isDraggingThis)) {
             sprite.x += mouseDeltaX;
             sprite.y += mouseDeltaY;
        }
    }

    var previous = "something";
    function updateTransformTool() {
        
        var skip = false;
        if (previous != selectedProp) {
            previous = selectedProp;
            skip = true;
        }
        if (previous == null && !skip) return;
        
        
        if (camInteract != null) {
            camInteract.scroll.x = camGame.scroll.x;
            camInteract.scroll.y = camGame.scroll.y;
            camInteract.zoom = camGame.zoom;
            camInteract.visible = selectedProp != null;
        }

        if (selectedProp == null) return;

        
        
        
        var propCorners = CornerCalculation.calculate(selectedProp);
        
        var invZoom = 1 / camGame.zoom; 
        var mouseX = FlxG.mouse.x;
        var mouseY = FlxG.mouse.y;
        var mouseDeltaX = mouseWorldDeltaX;
        var mouseDeltaY = mouseWorldDeltaY;

        var baseW = selectedProp.width / selectedProp.scale.x;
        var baseH = selectedProp.height / selectedProp.scale.y;

        var applyScale = function(sdx:Float, sdy:Float, anchorX:Float, anchorY:Float, isCorner:Bool) {
            var alt = FlxG.keys.pressed.ALT;
            var shift = FlxG.keys.pressed.SHIFT;

            if (shift) {
                if (isCorner) {
                    if (Math.abs(sdx) > Math.abs(sdy)) {
                        sdy = Math.abs(sdx) * (sdx >= 0 ? 1 : -1) * (selectedProp.scale.y / selectedProp.scale.x);
                    } else {
                        sdx = Math.abs(sdy) * (sdy >= 0 ? 1 : -1) * (selectedProp.scale.x / selectedProp.scale.y);
                    }
                } else {
                    if (sdx != 0) {
                        sdy = Math.abs(sdx) * (sdx >= 0 ? 1 : -1) * (selectedProp.scale.y / selectedProp.scale.x);
                        anchorY = 0.5;
                    } else if (sdy != 0) {
                        sdx = Math.abs(sdy) * (sdy >= 0 ? 1 : -1) * (selectedProp.scale.x / selectedProp.scale.y);
                        anchorX = 0.5;
                    }
                }
            }

            if (alt) {
                sdx *= 2;
                sdy *= 2;
                anchorX = 0.5;
                anchorY = 0.5;
            }

            var oldW = selectedProp.width;
            var oldH = selectedProp.height;

            selectedProp.scale.x += sdx;
            selectedProp.scale.y += sdy;

            if (selectedProp.scale.x < 0.1) selectedProp.scale.x = 0.1;
            if (selectedProp.scale.y < 0.1) selectedProp.scale.y = 0.1;

            selectedProp.updateHitbox();

            selectedProp.x -= (selectedProp.width - oldW) * anchorX;
            selectedProp.y -= (selectedProp.height - oldH) * anchorY;
        };

        if (tLC != null) {
            if (FlxG.mouse.overlaps(tLC, camGame) && FlxG.mouse.justPressed && !cancelInput) draggingHandle = "tLC";
            if ((FlxG.mouse.overlaps(tLC, camGame) && FlxG.mouse.pressed && draggingHandle == null && !cancelInput) || (draggingHandle == "tLC" && FlxG.mouse.pressed && !cancelInput)) {
                draggingHandle = "tLC";
                applyScale(-mouseDeltaX / baseW, -mouseDeltaY / baseH, 1, 1, true);
            }
            updateTransformHandle(tLC, propCorners.topLeftCorner.x - (tLC.width/2), propCorners.topLeftCorner.y - (tLC.height/2), mouseDeltaX, mouseDeltaY, invZoom, false, "tLC");
        }

        if (tMC != null) {
            if (FlxG.mouse.justPressed) mouseLock.x = mouseX;
            if (FlxG.mouse.overlaps(tMC, camGame) && FlxG.mouse.justPressed && !cancelInput) draggingHandle = "tMC";
            if ((FlxG.mouse.overlaps(tMC, camGame) && FlxG.mouse.pressed && draggingHandle == null && !cancelInput) || (draggingHandle == "tMC" && FlxG.mouse.pressed && !cancelInput)) {
                draggingHandle = "tMC";
                applyScale(0, -mouseDeltaY / baseH, 0.5, 1, false);
                FlxG.mouse.x = Std.int(mouseLock.x); 
            }
            updateTransformHandle(tMC, propCorners.topLeftCorner.x - (tLC.width/2) + (selectedProp.width/2), propCorners.topLeftCorner.y - (tLC.height/2), mouseDeltaX, mouseDeltaY, invZoom, true, "tMC");
        }

        if (mLC != null) {
            if (FlxG.mouse.justPressed) mouseLock.y = mouseY;
            if (FlxG.mouse.overlaps(mLC, camGame) && FlxG.mouse.justPressed && !cancelInput) draggingHandle = "mLC";
            if ((FlxG.mouse.overlaps(mLC, camGame) && FlxG.mouse.pressed && draggingHandle == null && !cancelInput) || (draggingHandle == "mLC" && FlxG.mouse.pressed && !cancelInput)) {
                draggingHandle = "mLC";
                applyScale(-mouseDeltaX / baseW, 0, 1, 0.5, false);
                FlxG.mouse.y = Std.int(mouseLock.y);
            }
            updateTransformHandle(mLC, propCorners.topLeftCorner.x - (mLC.width/2), propCorners.topLeftCorner.y - (mLC.height/2) + (selectedProp.height/2), mouseDeltaX, mouseDeltaY, invZoom, true, "mLC");
        }

        if (tRC != null) {
            if (FlxG.mouse.overlaps(tRC, camGame) && FlxG.mouse.justPressed && !cancelInput) draggingHandle = "tRC";
            if ((FlxG.mouse.overlaps(tRC, camGame) && FlxG.mouse.pressed && draggingHandle == null && !cancelInput) || (draggingHandle == "tRC" && FlxG.mouse.pressed && !cancelInput)) {
                draggingHandle = "tRC";
                applyScale(mouseDeltaX / baseW, -mouseDeltaY / baseH, 0, 1, true);
            }
            updateTransformHandle(tRC, propCorners.topLeftCorner.x - (tRC.width/2) + selectedProp.width, propCorners.topLeftCorner.y - (tRC.height/2), mouseDeltaX, mouseDeltaY, invZoom, false, "tRC");
        }

        if (mRC != null) {
            if (FlxG.mouse.justPressed) mouseLock.y = mouseY;
            if (FlxG.mouse.overlaps(mRC, camGame) && FlxG.mouse.justPressed && !cancelInput) draggingHandle = "mRC";
            if ((FlxG.mouse.overlaps(mRC, camGame) && FlxG.mouse.pressed && draggingHandle == null && !cancelInput) || (draggingHandle == "mRC" && FlxG.mouse.pressed && !cancelInput)) {
                draggingHandle = "mRC";
                applyScale(mouseDeltaX / baseW, 0, 0, 0.5, false);
                FlxG.mouse.y = Std.int(mouseLock.y);
            }
            updateTransformHandle(mRC, propCorners.topLeftCorner.x - (mRC.width/2) + selectedProp.width, propCorners.topLeftCorner.y - (mRC.height/2) + (selectedProp.height/2), mouseDeltaX, mouseDeltaY, invZoom, true, "mRC");
        }

        if (bLC != null) {
            if (FlxG.mouse.overlaps(bLC, camGame) && FlxG.mouse.justPressed && !cancelInput) draggingHandle = "bLC";
            if ((FlxG.mouse.overlaps(bLC, camGame) && FlxG.mouse.pressed && draggingHandle == null && !cancelInput) || (draggingHandle == "bLC" && FlxG.mouse.pressed && !cancelInput)) {
                draggingHandle = "bLC";
                applyScale(-mouseDeltaX / baseW, mouseDeltaY / baseH, 1, 0, true);
            }
            updateTransformHandle(bLC, propCorners.topLeftCorner.x - (bLC.width/2), propCorners.topLeftCorner.y - (bLC.height/2) + selectedProp.height, mouseDeltaX, mouseDeltaY, invZoom, false, "bLC");
        }

        if (bMC != null) {
            if (FlxG.mouse.justPressed) mouseLock.x = mouseX;
            if (FlxG.mouse.overlaps(bMC, camGame) && FlxG.mouse.justPressed && !cancelInput) draggingHandle = "bMC";
            if ((FlxG.mouse.overlaps(bMC, camGame) && FlxG.mouse.pressed && draggingHandle == null && !cancelInput) || (draggingHandle == "bMC" && FlxG.mouse.pressed && !cancelInput)) {
                draggingHandle = "bMC";
                applyScale(0, mouseDeltaY / baseH, 0.5, 0, false);
                FlxG.mouse.x = Std.int(mouseLock.x);
            }
            updateTransformHandle(bMC, propCorners.topLeftCorner.x - (bMC.width/2) + (selectedProp.width/2), propCorners.topLeftCorner.y - (bMC.height/2) + selectedProp.height, mouseDeltaX, mouseDeltaY, invZoom, true, "bMC");
        }

        if (bRC != null) {
            if (FlxG.mouse.overlaps(bRC, camGame) && FlxG.mouse.justPressed && !cancelInput) draggingHandle = "bRC";
            if ((FlxG.mouse.overlaps(bRC, camGame) && FlxG.mouse.pressed && draggingHandle == null && !cancelInput) || (draggingHandle == "bRC" && FlxG.mouse.pressed && !cancelInput)) {
                draggingHandle = "bRC";
                applyScale(mouseDeltaX / baseW, mouseDeltaY / baseH, 0, 0, true);
            }
            updateTransformHandle(bRC, propCorners.topLeftCorner.x - (bRC.width/2) + selectedProp.width, propCorners.topLeftCorner.y - (bRC.height/2) + selectedProp.height, mouseDeltaX, mouseDeltaY, invZoom, false, "bRC");
        }

        
        if (selectedProp.scale.x < 0.1) selectedProp.scale.x = 0.1;
        if (selectedProp.scale.y < 0.1) selectedProp.scale.y = 0.1;

        if (cC != null) {
            if (selectedProp != null) {
                var cScale = 0.8 * invZoom;
                if(cC.scale.x != cScale) {
                    cC.scale.set(cScale, cScale);
                    cC.updateHitbox();
                }
                cC.scrollFactor.set(selectedProp.scrollFactor.x, selectedProp.scrollFactor.y);

                if (FlxG.mouse.overlaps(cC, camGame) && FlxG.mouse.justPressed && !cancelInput) draggingHandle = "cC";

                if ((FlxG.mouse.overlaps(cC, camGame) && FlxG.mouse.pressed && draggingHandle == null && !cancelInput) || (draggingHandle == "cC" && FlxG.mouse.pressed && !cancelInput)) {
                    draggingHandle = "cC";
                    selectedProp.x += mouseDeltaX;
                    selectedProp.y += mouseDeltaY;
                }
                cC.x = selectedProp.x + (selectedProp.width/2) - (cC.width/2);
                cC.y = selectedProp.y + (selectedProp.height/2) - (cC.height/2);
                cC.alpha = FlxG.mouse.overlaps(cC, camGame) || draggingHandle == "cC" ? (FlxG.mouse.pressed ? 1 : 0.75) : 0.5;
            } else {
                cC.alpha = 0.01;
            }
        }
        
        selectedProp.updateHitbox();
    }

    function refreshPropList() {
        propListView.dataSource.clear();
        for (i in currentStage._data.props) {
            propListView.dataSource.add({ text: i.name, visible: true });
        }
    }

    function getSelectedPropData() {
        if (selectedProp != null) {
            for (i in currentStage._data.props) {
                if (i.name == selectedProp.name) {
                    return i;
                }
            }
        }
    }

    function getPropData(id:String) {
        if (selectedProp != null) {
            for (i in currentStage._data.props) {
                if (i.name == id) {
                    return i;
                }
            }
        }
    }

    var danceToggle = false;
    override function beatHit() {
        super.beatHit();
        var curBeat = get_conductorInUse().currentBeat;

        for (i in [player, opponent, spectator]) {
            if (i == null) continue;
            if (curBeat % i._data.danceEvery == 0) {
                if (i._data.startingAnimation == "danceRight" || i._data.startingAnimation == "danceLeft") {
                    i.playAnimation(danceToggle ? "danceRight" : "danceLeft", false, true);
                } else {
                    i.playAnimation(i._data.startingAnimation ?? "idle", false, true);
                }
                
                
            }
            
        }
        danceToggle = !danceToggle;
    }
    override function stepHit() {
        super.stepHit();
        var curStep = get_conductorInUse().currentStep;
    }

    function destroy() {
        super.destroy();
        Cursor.hide();
        
    }

    public function test() {
        FlxG.switchState(new MainMenuState());
    }

    function newNotification(title:String, body:String, ?type, ?expiryMs, ?actions) {
        notificationManager.addNotification({
            title: title,
            body: body,
            type: type ?? NotificationType.Default,
            expiryMs: expiryMs ?? null,
            actions: actions ?? []
        });
    }

    function initNotification() {
        notificationManager.addNotification({
            title: "Welcome!",
            body: "Welcome to the Nova Stage Editor! Press F1 for a user guide.",
            type: NotificationType.Default
        });
    }

    public function test2() {
        NotificationManager.instance.addNotification({
            title: "Test",
            body: "This is a test"
        });
    }

    function bind(component, mouseEvent, func) {
        switch (mouseEvent) {
            case MouseEvent.CLICK:
                component.onClick = func;
        }
    }

    function newKeybind(keys:Array<String>, action, ?type) {
        keybinds.push({
            keys: keys,
            type: type ?? "justPressed",
            action: action
        });
    }

    function templateAnimation() {
        var index = 0;
        for (i in getSelectedPropData().animations) {
            if (i.name.startsWith("New Animation")) {
                index++;
            }
        }
        return {
            offsets: [
                0,
                0
            ],
            prefix: "",
            frameIndices: [],
            name: "New Animation" + (index != 0 ? " (" + index + ")" : ""),
            looped: false,
            flipX: false,
            flipY: false,
            assetPath: null,
            frameRate: 24
        }
    }

    function templateProp() {
        var theZIndex = 0;
        var index = 0;
        for (i in currentStage._data.props) {
            if (i.name.startsWith("New Prop")) {
                index++;
            }
            if (i.zIndex > theZIndex)
                theZIndex = i.zIndex;
        }
        return {
            name: "New Prop" + (index != 0 ? " (" + index + ")" : ""),
            blend: "",
			color: "#FFFFFF",
			angle: 0,
			startingAnimation: null,
			assetPath: "icons/icon-bf",
			zIndex: theZIndex + 10,
			danceEvery: 0,
			position: [
				0,
				0
			],
			scale: Reflect.copy(new Stage('mainStage')._data.props[0]).scale,
			animType: "sparrow",
			flipX: false,
			flipY: false,
			isPixel: false,
			scroll: [
				1,
				1
			],
			alpha: 1,
			animations: []
        }
    }

    function stringToIndices(string:String):Array<Int> {
        string = string.replace(" ", "");
        var split = string.split(",");
        var indices = [];
        for (i in split) {
            if (Std.parseInt(i) != null)
                indices.push(Std.parseInt(i));
        }
        return indices;
    }

    function resetChars() {
        if (player != null) {
            player.zIndex = currentStage._data.characters.bf.zIndex;
            player.flipX = !player._data.flipX;
            if (currentStage._data.characters.bf.flipX)
                player.flipX = !player.flipX;
            player.x = currentStage._data.characters.bf.position[0] - player.characterOrigin.x;
            player.y = currentStage._data.characters.bf.position[1] - player.characterOrigin.y;
            player.scale.x = player._data.scale * (currentStage._data.characters.bf.scale ?? 1);
            player.scale.y = player._data.scale * (currentStage._data.characters.bf.scale ?? 1);
            player.scrollFactor.x = currentStage._data.characters.bf.scroll[0];
            player.scrollFactor.y = currentStage._data.characters.bf.scroll[1];
            player.alpha = currentStage._data.characters.bf.alpha;
            player.angle = currentStage._data.characters.bf.angle;

            if (!currentStage.members.contains(player)) {
                currentStage.characters.set('bf', player);
                currentStage.add(player);
            }

            player.playAnimation(player._data.animations[0].name, false, true);
            player.animation.finish();
            player.updateHitbox();
        }
        if (opponent != null) {
            opponent.zIndex = currentStage._data.characters.dad.zIndex;
            opponent.flipX = opponent._data.flipX;
            if (currentStage._data.characters.dad.flipX)
                opponent.flipX = !opponent.flipX;
            opponent.x = currentStage._data.characters.dad.position[0] - opponent.characterOrigin.x;
            opponent.y = currentStage._data.characters.dad.position[1] - opponent.characterOrigin.y;
            opponent.scale.x = opponent._data.scale * (currentStage._data.characters.dad.scale ?? 1);
            opponent.scale.y = opponent._data.scale * (currentStage._data.characters.dad.scale ?? 1);
            opponent.scrollFactor.x = currentStage._data.characters.dad.scroll[0];
            opponent.scrollFactor.y = currentStage._data.characters.dad.scroll[1];
            opponent.alpha = currentStage._data.characters.dad.alpha;
            opponent.angle = currentStage._data.characters.dad.angle;

            if (!currentStage.members.contains(opponent)) {
                currentStage.characters.set('dad', opponent);
                currentStage.add(opponent);
            }

            opponent.playAnimation(opponent._data.animations[0].name, false, true);
            opponent.animation.finish();
            opponent.updateHitbox();
        }

        if (spectator != null) {
            spectator.zIndex = currentStage._data.characters.gf.zIndex;
            spectator.flipX = spectator._data.flipX;
            if (currentStage._data.characters.gf.flipX)
                spectator.flipX = !spectator.flipX;
            spectator.x = currentStage._data.characters.gf.position[0] - spectator.characterOrigin.x;
            spectator.y = currentStage._data.characters.gf.position[1] - spectator.characterOrigin.y;
            spectator.scale.x = spectator._data.scale * (currentStage._data.characters.gf.scale ?? 1);
            spectator.scale.y = spectator._data.scale * (currentStage._data.characters.gf.scale ?? 1);
            spectator.scrollFactor.x = currentStage._data.characters.gf.scroll[0];
            spectator.scrollFactor.y = currentStage._data.characters.gf.scroll[1];
            spectator.alpha = currentStage._data.characters.gf.alpha;
            spectator.angle = currentStage._data.characters.gf.angle;

            if (!currentStage.members.contains(spectator)) {
                currentStage.characters.set('gf', spectator);
                currentStage.add(spectator);
            }

            spectator.playAnimation(spectator._data.animations[0].name);
            spectator.animation.finish();
            spectator.updateHitbox();
        }
        currentStage.refresh();
    }

    function reloadStageList() {
        stageList.dataSource.clear();

        var data = new Stage("mainStage");
        data.onCreate();

        customStageRegistry.set("mainStage", data._data);
        stageList.dataSource.add({ text: "Main Stage", id: "mainStage" });

        for (i in stageRegistry.entries.keys()) {
            if (!blacklist.contains(stageRegistry.entries.get(i).stageName)) {
                var data = new Stage(i);
                if (precacheStagesSave)
                    data.onCreate();
                customStageRegistry.set(i, data._data);
                stageList.dataSource.add({ text: stageRegistry.entries.get(i).stageName, id: i });
            }
        }
    }

    function checkImageExists(id:String) {
        var fileExists = false;
        var foldersToCheck = [
            "assets/",
            "assets/" + currentStage._data.directory + "/",
        ];

        for (mod in PolymodHandler.getAllMods()) {
            foldersToCheck.push("mods/" + mod.id + "/");
        }

        for (i in foldersToCheck) {
            if (FileUtil.fileExists(i + "images/" + id + ".png") || FileUtil.directoryExists(i + "images/" + id))
                fileExists = true;

            if (FileUtil.fileExists(i + "shared/images/" + id + ".png") || FileUtil.directoryExists(i + "images/" + id))
                fileExists = true;
        }

        return fileExists;
    }

    function getCornerCircle(outer:Bool) {
        var theCircle = FunkinSprite.create(0, 0, 'circle');
        
        theCircle.antialiasing = true;
        
        
        return theCircle;
    }

    /* override function onFocusLost(e) {
        super.onFocusLost(e);
        focusTimer = 2;
    }

    override function onFocus(e) {
        super.onFocus(e);
        focusTimer = 2;
    } */
    public function deselectStage(?target:Float) {
        target ??= 1;
        if (propListView != null) {
            propListView.selectedItems = [];
            propListView.selectedItem = null;
        }
        
        selectedProp = null;
        var index = 0;
        if (currentStage != null && currentStage.members != null) {
            for (i in currentStage.members) {
                var isProp = false;
                if (currentStage._data != null && currentStage._data.props != null) {
                    for (prop in currentStage._data.props) {
                        if (prop?.name == i?.name)
                            isProp = true;
                    }
                }
                if (isProp) {
                    i?.alpha = target ?? currentStage?._data?.props[index]?.alpha ?? 1;
                }

                if (player != null)
                    player.alpha = (player._data.alpha ?? 1) * (target ?? 1);

                if (opponent != null)
                    opponent.alpha = (opponent._data.alpha ?? 1) * (target ?? 1);

                if (spectator != null)
                    spectator.alpha = (spectator._data.alpha ?? 1) * (target ?? 1);

                index++;
            }
        }
    }

    public function deselectChars() {
        if (characterListView != null) {
            characterListView.selectedItems = [];
        }
        selectedCharacter = null;
        selectedCharacterType = "none";
    }
}