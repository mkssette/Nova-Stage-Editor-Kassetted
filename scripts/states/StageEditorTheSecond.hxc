    function reloadStage() {
        for (i in currentStage.members) {
            currentStage.remove(i, false);
        }
        currentStage.buildStage();
        for (i in currentStage._data.props) {
            trace(i.scale);
        }
        currentStage.refresh();
    }

    var targetSpriteY = 0;

    var mouseLock = {
        x: 0,
        y: 0
    }

    var forceUpdateBounds = false;

    var focusTimer = 0;

    function update(elapsed) {
        super.update(elapsed);
        
        if (focusTimer > 0) {
            focusTimer--;
            return;
        }
        
        get_conductorInUse().update();

        for (i in 0...propListView.dataSource.size) {
            var item = propListView.dataSource.get(i);
            currentStage.getNamedProp(item.text).visible = item.visible;
        }

        if (FlxG.mouse.justPressed) {
            redoHistory = [];
            var data = [];
            for (i in currentStage.members) {
                if (i != null && i.name != null) {
                    data.push({
                        name: i.name,
                        position: [i.x, i.y],
                        scale: [i.scale.x, i.scale.y],
                        alpha: i.alpha,
                        angle: i.angle,
                        blend: i.blend,
                        color: i.color,
                        flipX: i.flipX,
                        flipY: i.flipY,
                        zIndex: i.zIndex
                    });
                }
            }
            if (!compareData(history[history.length-1], data))
                history.push(data);

            if (history.length == 0)
                history.push(data);
        }

        if (FlxG.keys.pressed.CONTROL && FlxG.keys.justPressed.Y) redoCallback();
        if (FlxG.keys.pressed.CONTROL && FlxG.keys.justPressed.Z) undoCallback();


        for (i in 0...characterListView.dataSource.size) {
            var item = characterListView.dataSource.get(i);
            switch (item.text) {
                case "Player":
                    player.visible = item.visible;
                case "Opponent":
                    opponent.visible = item.visible;
                case "Spectator":
                    spectator.visible = item.visible;
            }
        }

        for (i in members) {
            //i.shader = i == selectedProp || i == selectedCharacter ? outlineShader : null;
        }

        /* if (selectedProp != null) {
            var point = new FlxPoint(FlxG.mouse.x, FlxG.mouse.y);
            point.x += camGame.scroll.x;
            point.y += camGame.scroll.y; 
            selectedProp.angle = FlxAngle.angleBetweenPoint(selectedProp, point, true);
            trace(selectedProp.angle);
        } */

        /* propListView.disabled = cancelInput;
        characterListView.disabled = cancelInput;
        stageList.disabled = cancelInput; */
        stageDataWindow.disabled = cancelInput;

        if (menuBar != null)
            menuBar.disabled = cancelInput;

        if (editCharacterWindow != null)
            editCharacterWindow.screenCenter();

        if (editPropWindow != null) {
            editPropWindow.screenCenter();
            editPropWindow.x += editPropWindowOffset;
        }

        if (editAnimationsWindow != null) {
            editAnimationsWindow.screenCenter();
            editAnimationsWindow.x += 90;
            editAnimationsWindow.height = editPropWindow.height;
        }

        if (FlxG.mouse.justPressed) {
            FlxG.sound.play(Paths.sound("click"));
            /* 
            var circleSprite = new FlxShapeCircle(0, 0, 5, {
                thickness: 2,
                color: FlxColor.WHITE,
                pixelHinting: false,
                scaleMode: null,
                capsStyle: null,
                jointStyle: null,
                miterLimit: 200
            }, FlxColor.TRANSPARENT);
            circleSprite.antialiasing = true;
            
            circleSprite.x = FlxG.mouse.x - (circleSprite.radius) + 3;
            circleSprite.y = FlxG.mouse.y - (circleSprite.radius) + 3; 
            add(circleSprite);

            FlxTween.num(5, 20, 0.2, {}, function(num) { 
                circleSprite.radius = num;
                circleSprite.x = FlxG.mouse.x - (circleSprite.radius) + 3;
                circleSprite.y = FlxG.mouse.y - (circleSprite.radius) + 3; 
            });
            FlxTween.tween(circleSprite, { alpha: 0 }, 0.2); 
            */
        }

        for (keybind in keybinds) {
            var pressed = true;
            var index = 0;
            //trace(keybind);
            for (key in keybind.keys) {
                if (index == keybind.keys.length - 1 && keybind.type != "pressed") {
                    if (!Reflect.getProperty(FlxG.keys.justPressed, key)) {
                        pressed = false;
                    }
                } else {
                    if (!Reflect.getProperty(FlxG.keys.pressed, key)) {
                        pressed = false;
                    }
                }
                index++;
            }
            if (pressed) {
                keybind.action(elapsed);
            }
        }

        if (camGame.zoom < 0.01) {
            camGame.zoom = 0.01;
        }

        updateTransformTool();

        if (!cancelInput && (selectedProp == null || (!FlxG.mouse.overlaps(selectedProp, camGame) && !usingTransformTool())) && selectedCharacter == null) {
            if (FlxG.mouse.pressed) {
                camGame.scroll.x -= (FlxG.mouse.deltaX/camGame.zoom) / (selectedProp != null ? selectedProp.scrollFactor.x : 1);
                camGame.scroll.y -= (FlxG.mouse.deltaY/camGame.zoom) / (selectedProp != null ? selectedProp.scrollFactor.y : 1);
            }
        }
        if (!cancelInput) {
            if (FlxG.mouse.wheel != 0) {
                camGame.zoom += FlxG.mouse.wheel/10;
            }
        }
        

        var npIndex = 0;
        for (negativePositive in np) {
            negativePositive.x = 0;
            negativePositive.y = 0;
            negativePositive.alpha = xLine.alpha;
            negativePositive.scale.set(2/camGame.zoom, 2/camGame.zoom);
            negativePositive.antialiasing = false;
            negativePositive.updateHitbox();
            switch (npIndex) {
                case 0:
                    negativePositive.x -= negativePositive.width + (10/camGame.zoom);
                    negativePositive.y -= negativePositive.height + (10/camGame.zoom);
                case 1:
                    negativePositive.x += (10/camGame.zoom);
                    negativePositive.y -= negativePositive.height + (10/camGame.zoom);
                case 2:
                    negativePositive.x -= negativePositive.width + (10/camGame.zoom);
                    negativePositive.y += (10/camGame.zoom);
                case 3:
                    negativePositive.x += (10/camGame.zoom);
                    negativePositive.y += (10/camGame.zoom);
            }
            npIndex++;
        }

        if (selectedProp == null || (!FlxG.mouse.overlaps(selectedProp, camGame) && !usingTransformTool())) updateTransformTool();

        yLine.scale.x = 2 / camGame.zoom;
        yLine.scale.y = FlxG.height * (1/camGame.zoom) * 2;
        yLine.screenCenter();
        yLine.updateHitbox();
        yLine.x = -yLine.width/2;
        yLine.scrollFactor.y = 0;
        yLine.visible = camHUD.visible;

        xLine.scale.y = 2 / camGame.zoom;
        xLine.scale.x = FlxG.width * (1/camGame.zoom) * 2;
        xLine.screenCenter();
        xLine.updateHitbox();
        xLine.y = -xLine.height/2;
        xLine.scrollFactor.x = 0;
        xLine.visible = camHUD.visible;

        playerBoundingBox.alpha = opponentBoundingBox.alpha = spectatorBoundingBox.alpha = camHUD.visible ? (!FlxG.keys.pressed.Q && !FlxG.keys.pressed.E ? 1 : 0) : 0;

        if ((!FlxG.keys.pressed.Q && !FlxG.keys.pressed.E) || forceUpdateBounds) {
    
    
            /* if ((playerBoundingBox.shapeWidth == playerBoundingBox.shapeHeight && playerBoundingBox.shapeWidth == 200) || forceUpdateBounds)    
                resetChars(); */
    
            if ((playerBoundingBox.lineStyle.thickness != 2 / camGame.zoom || forceUpdateBounds) && playerBoundingBox.visible) {
                playerBoundingBox.lineStyle.thickness = 2 / camGame.zoom;
                playerBoundingBox.redrawShape();
                playerBoundingBox.shapeWidth = FlxG.width / currentStage._data.cameraZoom;
                playerBoundingBox.shapeHeight = FlxG.height / currentStage._data.cameraZoom;
                playerBoundingBox.updateHitbox();
                playerBoundingBox.x = player.cameraFocusPoint.x - (playerBoundingBox.width/2) + currentStage._data.characters.bf.cameraOffsets[0] + 2;
                playerBoundingBox.y = player.cameraFocusPoint.y - (playerBoundingBox.height/2) + currentStage._data.characters.bf.cameraOffsets[1] + 2;
            }
    
            if ((opponentBoundingBox.lineStyle.thickness != 2 / camGame.zoom || forceUpdateBounds) && opponentBoundingBox.visible) {
                opponentBoundingBox.lineStyle.thickness = 2 / camGame.zoom;
                opponentBoundingBox.redrawShape();
                opponentBoundingBox.shapeWidth = FlxG.width / currentStage._data.cameraZoom;
                opponentBoundingBox.shapeHeight = FlxG.height / currentStage._data.cameraZoom;
                opponentBoundingBox.updateHitbox();
                opponentBoundingBox.x = opponent.cameraFocusPoint.x - (opponentBoundingBox.width/2) + currentStage._data.characters.dad.cameraOffsets[0] + 2;
                opponentBoundingBox.y = opponent.cameraFocusPoint.y - (opponentBoundingBox.height/2) + currentStage._data.characters.dad.cameraOffsets[1] + 2;
            }
    
            if ((spectatorBoundingBox.lineStyle.thickness != 2 / camGame.zoom || forceUpdateBounds) && spectatorBoundingBox.visible) {
                spectatorBoundingBox.lineStyle.thickness = 2 / camGame.zoom;
                spectatorBoundingBox.redrawShape();
                spectatorBoundingBox.shapeWidth = FlxG.width / currentStage._data.cameraZoom;
                spectatorBoundingBox.shapeHeight = FlxG.height / currentStage._data.cameraZoom;
                spectatorBoundingBox.updateHitbox();
                spectatorBoundingBox.x = spectator.cameraFocusPoint.x - (spectatorBoundingBox.width/2) + currentStage._data.characters.gf.cameraOffsets[0] + 2;
                spectatorBoundingBox.y = spectator.cameraFocusPoint.y - (spectatorBoundingBox.height/2) + currentStage._data.characters.gf.cameraOffsets[1] + 2;
            }
        }




        forceUpdateBounds = false;
 
        
        if (selectedProp != null /* && FlxG.mouse.pressed */ && !cancelInput) {
            for (i in currentStage._data.props) {
                if (i.name == selectedProp.name) {
                    i.position[0] = Math.round(selectedProp.x);
                    i.position[1] = Math.round(selectedProp.y);
                }
            }
            /* selectedProp.x += FlxG.mouse.deltaX / camGame.zoom;
            selectedProp.y += FlxG.mouse.deltaY / camGame.zoom;
            for (i in currentStage._data.props) {
                if (i.name == selectedProp.name) {
                    i.position[0] = Math.round(selectedProp.x);
                    i.position[1] = Math.round(selectedProp.y);
                }
            } */
        }

        if (selectedCharacter != null && FlxG.mouse.pressed && !cancelInput) {
            selectedCharacter.x += FlxG.mouse.deltaX / camGame.zoom;
            selectedCharacter.y += FlxG.mouse.deltaY / camGame.zoom;
            
            switch (selectedCharacterType) {
                case "bf":
                    currentStage._data.characters.bf.position[0] = Math.round(selectedCharacter.x) + selectedCharacter.characterOrigin.x;
                    currentStage._data.characters.bf.position[1] = Math.round(selectedCharacter.y) + selectedCharacter.characterOrigin.y;
                case "gf":
                    currentStage._data.characters.gf.position[0] = Math.round(selectedCharacter.x) + selectedCharacter.characterOrigin.x;
                    currentStage._data.characters.gf.position[1] = Math.round(selectedCharacter.y) + selectedCharacter.characterOrigin.y;
                case "dad":
                    currentStage._data.characters.dad.position[0] = Math.round(selectedCharacter.x) + selectedCharacter.characterOrigin.x;
                    currentStage._data.characters.dad.position[1] = Math.round(selectedCharacter.y) + selectedCharacter.characterOrigin.y;
            }
        }

        if (FlxG.mouse.justPressedRight && selectedProp != null && FlxG.mouse.overlaps(selectedProp, camGame)) {
            rightClickMenu = RuntimeComponentBuilder.build(Paths.ui("stage-editor/rightClick/prop"));
            rightClickMenu.x = FlxG.mouse.x;
            rightClickMenu.y = FlxG.mouse.y;
            rightClickMenu.cameras = [camInteract];
            add(rightClickMenu);

            duplicatePropCallback = ()->{
                var proper = Reflect.copy(getSelectedPropData());
                var properCount = 1;
                for (i in currentStage._data.props) {
                    if (i.name.startsWith(proper.name)) properCount++;
                }
                proper.name = proper.name + " (" + properCount + ")";
                currentStage._data.props.push(proper);
                refreshPropList();
                reloadStage();
                resetChars();
                
                // propListView.selectedItems = [];
                propListView.selectedItem = propListView.dataSource.get(propListView.dataSource.size-1);
                propListView.selectedItems = [propListView.dataSource.get(propListView.dataSource.size-1)];
            }

            bind(rightClickMenu.findComponent("edit"), MouseEvent.CLICK, editPropCallback);
            bind(rightClickMenu.findComponent("delete"), MouseEvent.CLICK, deletePropCallback);
            // bind(rightClickMenu.findComponent("duplicate"), MouseEvent.CLICK, duplicatePropCallback);
        }

    }

    function usingTransformTool() {
        return FlxG.mouse.overlaps(tLC, camGame) || FlxG.mouse.overlaps(tMC, camGame) || FlxG.mouse.overlaps(tRC, camGame) || FlxG.mouse.overlaps(mRC, camGame) || FlxG.mouse.overlaps(bRC, camGame) || FlxG.mouse.overlaps(bMC, camGame) || FlxG.mouse.overlaps(bLC, camGame) || FlxG.mouse.overlaps(mLC, camGame);
    }

    var previous = "something";
    function updateTransformTool() {
        var skip = false;
        if (previous != selectedProp) {
            previous = selectedProp;
            skip = true;
        }
        if (previous == null && !skip) return;
        // if (FlxG.keys.pressed.Q || FlxG.keys.pressed.E) return;
        if (camInteract != null) {
            camInteract.scroll.x = camGame.scroll.x;
            camInteract.scroll.y = camGame.scroll.y;
            camInteract.zoom = camGame.zoom;
            camInteract.visible = selectedProp != null;
        }
        
        var selectedObj = selectedProp != null ? selectedProp : (selectedCharacter != null ? selectedCharacter : null);

        if (selectedProp != null && tLC != null) {
            tLC.scale.set(1/camGame.zoom, 1/camGame.zoom);
            tLC.updateHitbox();
            tLC.scrollFactor.x = selectedProp.scrollFactor.x;
            tLC.scrollFactor.y = selectedProp.scrollFactor.y;
            tLC.x += FlxG.mouse.deltaX / camGame.zoom;
            tLC.y += FlxG.mouse.deltaY / camGame.zoom;
            if (FlxG.mouse.overlaps(tLC, camGame) && FlxG.mouse.pressed && !cancelInput) {
                selectedProp.x += FlxG.mouse.deltaX / camGame.zoom;
                selectedProp.y += FlxG.mouse.deltaY / camGame.zoom;
                selectedProp.updateHitbox();
                selectedProp.scale.x -= (FlxG.mouse.deltaX / camGame.zoom)/(selectedProp.width / selectedProp.scale.x);
                selectedProp.scale.y -= (FlxG.mouse.deltaY / camGame.zoom)/(selectedProp.height / selectedProp.scale.y);
                if (selectedProp.scale.x < 0.1) {
                    selectedProp.scale.x = 0.1;
                }
                if (selectedProp.scale.y < 0.1) {
                    selectedProp.scale.y = 0.1;
                }
            }
            tLC.x = CornerCalculation.calculate(selectedProp).topLeftCorner.x - (tLC.width/2);
            tLC.y = CornerCalculation.calculate(selectedProp).topLeftCorner.y - (tLC.height/2);

            tLC.alpha = FlxG.mouse.overlaps(tLC, camGame) ? (FlxG.mouse.pressed ? 1 : 0.75) : 0.5;
        }

        if (tLC != null) {
            tLC.alpha = selectedProp != null ? tLC.alpha : 0.01;
            
            tLCi.alpha = tLC.alpha;
            tLCi.scrollFactor = tLC.scrollFactor;
            tLCi.scale = tLC.scale;
            tLCi.x = tLC.x + (tLC.width/2) - (tLCi.width/2);
            tLCi.y = tLC.y + (tLC.height/2) - (tLCi.height/2);
        }

        if (selectedProp != null && tLC != null) {
            tMC.scale.set(0.9/camGame.zoom, 0.9/camGame.zoom);
            tMC.updateHitbox();
            tMC.scrollFactor.x = selectedProp.scrollFactor.x;
            tMC.scrollFactor.y = selectedProp.scrollFactor.y;
            tMC.x += FlxG.mouse.deltaX / camGame.zoom;
            tMC.y += FlxG.mouse.deltaY / camGame.zoom;
            if (FlxG.mouse.justPressed) {
                mouseLock.x = FlxG.mouse.x;
            }
            if (FlxG.mouse.overlaps(tMC, camGame) && FlxG.mouse.pressed && !cancelInput) {
                selectedProp.y += FlxG.mouse.deltaY / camGame.zoom;
                selectedProp.updateHitbox();
                selectedProp.scale.y -= (FlxG.mouse.deltaY / camGame.zoom)/(selectedProp.height / selectedProp.scale.y);
                FlxG.mouse.x = mouseLock.x;
                if (selectedProp.scale.y < 0.1) {
                    selectedProp.scale.y = 0.1;
                }
            }
            tMC.x = CornerCalculation.calculate(selectedProp).topLeftCorner.x - (tLC.width/2) + (selectedProp.width/2);
            tMC.y = CornerCalculation.calculate(selectedProp).topLeftCorner.y - (tLC.height/2);

            tMC.alpha = FlxG.mouse.overlaps(tMC, camGame) ? (FlxG.mouse.pressed ? 1 : 0.75) : 0.5;
        }

        if (tMC != null) {
            tMC.alpha = selectedProp != null ? tMC.alpha : 0.01;
            
            tMCi.alpha = tMC.alpha;
            tMCi.scrollFactor = tMC.scrollFactor;
            tMCi.scale = tMC.scale;
            tMCi.x = tMC.x + (tMC.width/2) - (tMCi.width/2);
            tMCi.y = tMC.y + (tMC.height/2) - (tMCi.height/2);
        }

        if (selectedProp != null && tLC != null) {
            mLC.scale.set(0.9/camGame.zoom, 0.9/camGame.zoom);
            mLC.updateHitbox();
            mLC.scrollFactor.x = selectedProp.scrollFactor.x;
            mLC.scrollFactor.y = selectedProp.scrollFactor.y;
            mLC.x += FlxG.mouse.deltaX / camGame.zoom;
            mLC.y += FlxG.mouse.deltaY / camGame.zoom;
            if (FlxG.mouse.justPressed) {
                mouseLock.y = FlxG.mouse.y;
            }
            if (FlxG.mouse.overlaps(mLC, camGame) && FlxG.mouse.pressed && !cancelInput) {
                selectedProp.x += FlxG.mouse.deltaX / camGame.zoom;
                selectedProp.updateHitbox();
                selectedProp.scale.x -= (FlxG.mouse.deltaX / camGame.zoom)/(selectedProp.width / selectedProp.scale.x);
                FlxG.mouse.y = mouseLock.y;
                if (selectedProp.scale.x < 0.1) {
                    selectedProp.scale.x = 0.1;
                }
            }
            mLC.x = CornerCalculation.calculate(selectedProp).topLeftCorner.x - (mLC.width/2);
            mLC.y = CornerCalculation.calculate(selectedProp).topLeftCorner.y - (mLC.height/2) + (selectedProp.height/2);

            mLC.alpha = FlxG.mouse.overlaps(mLC, camGame) ? (FlxG.mouse.pressed ? 1 : 0.75) : 0.5;
        }

        if (mLC != null) {
            mLC.alpha = selectedProp != null ? mLC.alpha : 0.01;
            
            mLCi.alpha = mLC.alpha;
            mLCi.scrollFactor = mLC.scrollFactor;
            mLCi.scale = mLC.scale;
            mLCi.x = mLC.x + (mLC.width/2) - (mLCi.width/2);
            mLCi.y = mLC.y + (mLC.height/2) - (mLCi.height/2);
        }

        if (selectedProp != null && tRC != null) {
            tRC.scale.set(1/camGame.zoom, 1/camGame.zoom);
            tRC.updateHitbox();
            tRC.scrollFactor.x = selectedProp.scrollFactor.x;
            tRC.scrollFactor.y = selectedProp.scrollFactor.y;
            tRC.x += FlxG.mouse.deltaX / camGame.zoom;
            tRC.y += FlxG.mouse.deltaY / camGame.zoom;
            if (FlxG.mouse.overlaps(tRC, camGame) && FlxG.mouse.pressed && !cancelInput) {
                // selectedProp.x += FlxG.mouse.deltaX / camGame.zoom;
                selectedProp.y += FlxG.mouse.deltaY / camGame.zoom;
                selectedProp.updateHitbox();
                selectedProp.scale.x += (FlxG.mouse.deltaX / camGame.zoom)/(selectedProp.width / selectedProp.scale.x);
                selectedProp.scale.y -= (FlxG.mouse.deltaY / camGame.zoom)/(selectedProp.height / selectedProp.scale.y);
                if (selectedProp.scale.x < 0.1) {
                    selectedProp.scale.x = 0.1;
                }
                if (selectedProp.scale.y < 0.1) {
                    selectedProp.scale.y = 0.1;
                }
            }
            tRC.x = CornerCalculation.calculate(selectedProp).topLeftCorner.x - (tRC.width/2) + selectedProp.width;
            tRC.y = CornerCalculation.calculate(selectedProp).topLeftCorner.y - (tRC.height/2);

            tRC.alpha = FlxG.mouse.overlaps(tRC, camGame) ? (FlxG.mouse.pressed ? 1 : 0.75) : 0.5;
        }

        if (tLC != null) {
            tRC.alpha = selectedProp != null ? tRC.alpha : 0.01;
            
            tRCi.alpha = tRC.alpha;
            tRCi.scrollFactor = tRC.scrollFactor;
            tRCi.scale = tRC.scale;
            tRCi.x = tRC.x + (tRC.width/2) - (tRCi.width/2);
            tRCi.y = tRC.y + (tRC.height/2) - (tRCi.height/2);
        }

        if (selectedProp != null && mRC != null) {
            mRC.scale.set(0.9/camGame.zoom, 0.9/camGame.zoom);
            mRC.updateHitbox();
            mRC.scrollFactor.x = selectedProp.scrollFactor.x;
            mRC.scrollFactor.y = selectedProp.scrollFactor.y;
            mRC.x += FlxG.mouse.deltaX / camGame.zoom;
            mRC.y += FlxG.mouse.deltaY / camGame.zoom;
            if (FlxG.mouse.justPressed) {
                mouseLock.y = FlxG.mouse.y;
            }
            if (FlxG.mouse.overlaps(mRC, camGame) && FlxG.mouse.pressed && !cancelInput) {
                //selectedProp.x += FlxG.mouse.deltaX / camGame.zoom;
                selectedProp.updateHitbox();
                selectedProp.scale.x += (FlxG.mouse.deltaX / camGame.zoom)/(selectedProp.width / selectedProp.scale.x);
                FlxG.mouse.y = mouseLock.y;
                if (selectedProp.scale.x < 0.1) {
                    selectedProp.scale.x = 0.1;
                }
            }
            mRC.x = CornerCalculation.calculate(selectedProp).topLeftCorner.x - (mRC.width/2) + (selectedProp.width);
            mRC.y = CornerCalculation.calculate(selectedProp).topLeftCorner.y - (mRC.height/2) + (selectedProp.height/2);

            mRC.alpha = FlxG.mouse.overlaps(mRC, camGame) ? (FlxG.mouse.pressed ? 1 : 0.75) : 0.5;
        }

        if (mRC != null) {
            mRC.alpha = selectedProp != null ? mRC.alpha : 0.01;
            
            mRCi.alpha = mRC.alpha;
            mRCi.scrollFactor = mRC.scrollFactor;
            mRCi.scale = mRC.scale;
            mRCi.x = mRC.x + (mRC.width/2) - (mRCi.width/2);
            mRCi.y = mRC.y + (mRC.height/2) - (mRCi.height/2);
        }

        if (selectedProp != null && bLC != null) {
            bLC.scale.set(1/camGame.zoom, 1/camGame.zoom);
            bLC.updateHitbox();
            bLC.scrollFactor.x = selectedProp.scrollFactor.x;
            bLC.scrollFactor.y = selectedProp.scrollFactor.y;
            bLC.x += FlxG.mouse.deltaX / camGame.zoom;
            bLC.y += FlxG.mouse.deltaY / camGame.zoom;
            if (FlxG.mouse.overlaps(bLC, camGame) && FlxG.mouse.pressed && !cancelInput) {
                selectedProp.x += FlxG.mouse.deltaX / camGame.zoom;
                //selectedProp.y += FlxG.mouse.deltaY / camGame.zoom;
                selectedProp.updateHitbox();
                selectedProp.scale.x -= (FlxG.mouse.deltaX / camGame.zoom)/(selectedProp.width / selectedProp.scale.x);
                selectedProp.scale.y += (FlxG.mouse.deltaY / camGame.zoom)/(selectedProp.height / selectedProp.scale.y);
                if (selectedProp.scale.x < 0.1) {
                    selectedProp.scale.x = 0.1;
                }
                if (selectedProp.scale.y < 0.1) {
                    selectedProp.scale.y = 0.1;
                }
            }
            bLC.x = CornerCalculation.calculate(selectedProp).topLeftCorner.x - (bLC.width/2);
            bLC.y = CornerCalculation.calculate(selectedProp).topLeftCorner.y - (bLC.height/2) + selectedProp.height;

            bLC.alpha = FlxG.mouse.overlaps(bLC, camGame) ? (FlxG.mouse.pressed ? 1 : 0.75) : 0.5;
        }

        if (bLC != null) {
            bLC.alpha = selectedProp != null ? bLC.alpha : 0.01;
            
            bLCi.alpha = bLC.alpha;
            bLCi.scrollFactor = bLC.scrollFactor;
            bLCi.scale = bLC.scale;
            bLCi.x = bLC.x + (bLC.width/2) - (bLCi.width/2);
            bLCi.y = bLC.y + (bLC.height/2) - (bLCi.height/2);
        }

        if (selectedProp != null && bMC != null) {
            bMC.scale.set(0.9/camGame.zoom, 0.9/camGame.zoom);
            bMC.updateHitbox();
            bMC.scrollFactor.x = selectedProp.scrollFactor.x;
            bMC.scrollFactor.y = selectedProp.scrollFactor.y;
            bMC.x += FlxG.mouse.deltaX / camGame.zoom;
            bMC.y += FlxG.mouse.deltaY / camGame.zoom;
            if (FlxG.mouse.justPressed) {
                mouseLock.x = FlxG.mouse.x;
            }
            if (FlxG.mouse.overlaps(bMC, camGame) && FlxG.mouse.pressed && !cancelInput) {
                // selectedProp.y += FlxG.mouse.deltaY / camGame.zoom;
                selectedProp.updateHitbox();
                selectedProp.scale.y += (FlxG.mouse.deltaY / camGame.zoom)/(selectedProp.height / selectedProp.scale.y);
                FlxG.mouse.x = mouseLock.x;
                if (selectedProp.scale.y < 0.1) {
                    selectedProp.scale.y = 0.1;
                }
            }
            bMC.x = CornerCalculation.calculate(selectedProp).topLeftCorner.x - (bMC.width/2) + (selectedProp.width/2);
            bMC.y = CornerCalculation.calculate(selectedProp).topLeftCorner.y - (bMC.height/2) + (selectedProp.height);

            bMC.alpha = FlxG.mouse.overlaps(bMC, camGame) ? (FlxG.mouse.pressed ? 1 : 0.75) : 0.5;
        }

        if (bMC != null) {
            bMC.alpha = selectedProp != null ? bMC.alpha : 0.01;
            
            bMCi.alpha = bMC.alpha;
            bMCi.scrollFactor = bMC.scrollFactor;
            bMCi.scale = bMC.scale;
            bMCi.x = bMC.x + (bMC.width/2) - (bMCi.width/2);
            bMCi.y = bMC.y + (bMC.height/2) - (bMCi.height/2);
        }

        if (selectedProp != null && bRC != null) {
            bRC.scale.set(1/camGame.zoom, 1/camGame.zoom);
            bRC.updateHitbox();
            bRC.scrollFactor.x = selectedProp.scrollFactor.x;
            bRC.scrollFactor.y = selectedProp.scrollFactor.y;
            bRC.x += FlxG.mouse.deltaX / camGame.zoom;
            bRC.y += FlxG.mouse.deltaY / camGame.zoom;
            if (FlxG.mouse.overlaps(bRC, camGame) && FlxG.mouse.pressed && !cancelInput) {
                // selectedProp.x += FlxG.mouse.deltaX / camGame.zoom;
                //selectedProp.y += FlxG.mouse.deltaY / camGame.zoom;
                selectedProp.updateHitbox();
                selectedProp.scale.x += (FlxG.mouse.deltaX / camGame.zoom)/(selectedProp.width / selectedProp.scale.x);
                selectedProp.scale.y += (FlxG.mouse.deltaY / camGame.zoom)/(selectedProp.height / selectedProp.scale.y);
                if (selectedProp.scale.x < 0.1) {
                    selectedProp.scale.x = 0.1;
                }
                if (selectedProp.scale.y < 0.1) {
                    selectedProp.scale.y = 0.1;
                }
            }
            bRC.x = CornerCalculation.calculate(selectedProp).topLeftCorner.x - (bRC.width/2) + selectedProp.width;
            bRC.y = CornerCalculation.calculate(selectedProp).topLeftCorner.y - (bRC.height/2) + selectedProp.height;

            bRC.alpha = FlxG.mouse.overlaps(bRC, camGame) ? (FlxG.mouse.pressed ? 1 : 0.75) : 0.5;
        }

        if (bRC != null) {
            bRC.alpha = selectedProp != null ? bRC.alpha : 0.01;
            
            bRCi.alpha = bRC.alpha;
            bRCi.scrollFactor = bRC.scrollFactor;
            bRCi.scale = bRC.scale;
            bRCi.x = bRC.x + (bRC.width/2) - (bRCi.width/2);
            bRCi.y = bRC.y + (bRC.height/2) - (bRCi.height/2);
        }

        if (tL != null) {
            if (selectedProp != null) {
                tL.visible = true;
                tL.scrollFactor = selectedProp.scrollFactor;
                tL.x = selectedProp.x + (selectedProp.width/2);
                tL.y = selectedProp.y;
                tL.scale.x = selectedProp.width;
                tL.scale.y = 2 / camGame.zoom;               
            } else {
                tL.visible = false;
            }
        }

        if (lL != null) {
            if (selectedProp != null) {
                lL.visible = true;
                lL.scrollFactor = selectedProp.scrollFactor;
                lL.x = selectedProp.x;
                lL.y = selectedProp.y + (selectedProp.height/2);
                lL.scale.x = 2 / camGame.zoom;
                lL.scale.y = selectedProp.height;
            } else {
                lL.visible = false;
            }
        }

        if (rL != null) {
            if (selectedProp != null) {
                rL.visible = true;
                rL.scale.x = 2 / camGame.zoom;
                rL.scale.y = selectedProp.height;
                rL.updateHitbox();
                rL.scrollFactor = selectedProp.scrollFactor;
                rL.x = selectedProp.x + selectedProp.width;
                rL.y = selectedProp.y;
            } else {
                rL.visible = false;
            }
        }

        if (bL != null) {
            if (selectedProp != null) {
                bL.visible = true;
                bL.scale.x = selectedProp.width;
                bL.scale.y = 2 / camGame.zoom;
                bL.updateHitbox();
                bL.scrollFactor = selectedProp.scrollFactor;
                bL.x = selectedProp.x;
                bL.y = selectedProp.y + selectedProp.height;
            } else {
                bL.visible = false;
            }
        }

        if (cC != null) {
            
            if (selectedProp != null) {
                cC.scale.set(0.8/camGame.zoom, 0.8/camGame.zoom);
                cC.updateHitbox();
                cC.scrollFactor.x = selectedProp.scrollFactor.x;
                cC.scrollFactor.y = selectedProp.scrollFactor.y;
                cC.x += FlxG.mouse.deltaX / camGame.zoom;
                cC.y += FlxG.mouse.deltaY / camGame.zoom;

                if (FlxG.mouse.overlaps(cC, camGame) && FlxG.mouse.pressed) {
                    selectedProp.x += FlxG.mouse.deltaX / camGame.zoom;
                    selectedProp.y += FlxG.mouse.deltaY / camGame.zoom;
                }

                cC.x = selectedProp.x + (selectedProp.width/2) - (cC.width/2);
                cC.y = selectedProp.y + (selectedProp.height/2) - (cC.height/2);

                
                cC.alpha = FlxG.mouse.overlaps(cC, camGame) ? (FlxG.mouse.pressed ? 1 : 0.75) : 0.5;
            } else {
                cC.alpha = 0.01;
            }
        }


        if (selectedProp == null) return;
        getPropData(selectedProp.name).scale = Either.Right([Math.round(selectedProp.scale.x*100)/100, Math.round(selectedProp.scale.y*100)/100]);
    }

    function refreshPropList() {
        propListView.dataSource.clear();
        for (i in currentStage._data.props) {
            propListView.dataSource.add({ text: i.name, visible: true });
        }
    }

    function getSelectedPropData() {
        if (selectedProp != null) {
            for (i in currentStage._data.props) {
                if (i.name == selectedProp.name) {
                    return i;
                }
            }
        }
    }

    function getPropData(id:String) {
        if (selectedProp != null) {
            for (i in currentStage._data.props) {
                if (i.name == id) {
                    return i;
                }
            }
        }
    }

    var danceToggle = false;
    override function beatHit() {
        super.beatHit();
        var curBeat = get_conductorInUse().currentBeat;

        for (i in [player, opponent, spectator]) {
            if (i == null) continue;
            if (curBeat % i._data.danceEvery == 0) {
                if (i._data.startingAnimation == "danceRight" || i._data.startingAnimation == "danceLeft") {
                    i.playAnimation(danceToggle ? "danceRight" : "danceLeft");
                } else {
                    i.playAnimation(i._data.startingAnimation ?? "idle");
                }
                // player.playAnimation(, true);
                // player.playAnimation("idle", true);
            }
            // test
        }
        danceToggle = !danceToggle;
    }
    override function stepHit() {
        super.stepHit();
        var curStep = get_conductorInUse().currentStep;
    }

    function destroy() {
        super.destroy();
        Cursor.hide();
        Save.writeToAvailableSlot('nova-editors', save.data);
    }

    public function test() {
        FlxG.switchState(new MainMenuState());
    }

    function newNotification(title:String, body:String, ?type, ?expiryMs, ?actions) {
        notificationManager.addNotification({
            title: title,
            body: body,
            type: type ?? NotificationType.Default,
            expiryMs: expiryMs ?? null,
            actions: actions ?? []
        });
    }

    function initNotification() {
        notificationManager.addNotification({
            title: "Welcome!",
            body: "Welcome to the Nova Stage Editor! Press F1 for a user guide.",
            type: NotificationType.Default
        });
    }

    public function test2() {
        NotificationManager.instance.addNotification({
            title: "Test",
            body: "This is a test"
        });
    }

    function bind(component, mouseEvent, func) {
        switch (mouseEvent) {
            case MouseEvent.CLICK:
                component.onClick = func;
        }
    }

    function newKeybind(keys:Array<String>, action, ?type) {
        keybinds.push({
            keys: keys,
            type: type ?? "justPressed",
            action: action
        });
    }

    function templateAnimation() {
        var index = 0;
        for (i in getSelectedPropData().animations) {
            if (i.name.startsWith("New Animation")) {
                index++;
            }
        }
        return {
            offsets: [
                0,
                0
            ],
            prefix: "",
            frameIndices: [],
            name: "New Animation" + (index != 0 ? " (" + index + ")" : ""),
            looped: false,
            flipX: false,
            flipY: false,
            assetPath: null,
            frameRate: 24
        }
    }

    function templateProp() {
        var theZIndex = 0;
        var index = 0;
        for (i in currentStage._data.props) {
            if (i.name.startsWith("New Prop")) {
                index++;
            }
            if (i.zIndex > theZIndex)
                theZIndex = i.zIndex;
        }
        return {
            name: "New Prop" + (index != 0 ? " (" + index + ")" : ""),
            blend: "",
			color: "#FFFFFF",
			angle: 0,
			startingAnimation: null,
			assetPath: "icons/icon-bf",
			zIndex: theZIndex + 10,
			danceEvery: 0,
			position: [
				0,
				0
			],
			scale: Reflect.copy(new Stage('mainStage')._data.props[0]).scale,
			animType: "sparrow",
			flipX: false,
			flipY: false,
			isPixel: false,
			scroll: [
				1,
				1
			],
			alpha: 1,
			animations: []
        }
    }

    function stringToIndices(string:String):Array<Int> {
        string = string.replace(" ", "");
        var split = string.split(",");
        var indices = [];
        for (i in split) {
            if (Std.parseInt(i) != null)
                indices.push(Std.parseInt(i));
        }
        return indices;
    }

    function resetChars() {
        if (player != null) {
            player.zIndex = currentStage._data.characters.bf.zIndex;
            player.flipX = !player._data.flipX;
            if (currentStage._data.characters.bf.flipX)
                player.flipX = !player.flipX;
            player.x = currentStage._data.characters.bf.position[0] - player.characterOrigin.x;
            player.y = currentStage._data.characters.bf.position[1] - player.characterOrigin.y;
            player.scale.x = player._data.scale * (currentStage._data.characters.bf.scale ?? 1);
            player.scale.y = player._data.scale * (currentStage._data.characters.bf.scale ?? 1);
            player.scrollFactor.x = currentStage._data.characters.bf.scroll[0];
            player.scrollFactor.y = currentStage._data.characters.bf.scroll[1];
            player.alpha = currentStage._data.characters.bf.alpha;
            player.angle = currentStage._data.characters.bf.angle;
            
            if (!currentStage.members.contains(player)) {
                currentStage.characters.set('bf', player);
                currentStage.add(player);
            }

            player.playAnimation(player._data.animations[0].name);
            player.animation.finish();
            player.updateHitbox();
        }
        if (opponent != null) {
            opponent.zIndex = currentStage._data.characters.dad.zIndex;
            opponent.flipX = opponent._data.flipX;
            if (currentStage._data.characters.dad.flipX)
                opponent.flipX = !opponent.flipX;
            opponent.x = currentStage._data.characters.dad.position[0] - opponent.characterOrigin.x;
            opponent.y = currentStage._data.characters.dad.position[1] - opponent.characterOrigin.y;
            opponent.scale.x = opponent._data.scale * (currentStage._data.characters.dad.scale ?? 1);
            opponent.scale.y = opponent._data.scale * (currentStage._data.characters.dad.scale ?? 1);
            opponent.scrollFactor.x = currentStage._data.characters.dad.scroll[0];
            opponent.scrollFactor.y = currentStage._data.characters.dad.scroll[1];
            opponent.alpha = currentStage._data.characters.dad.alpha;
            opponent.angle = currentStage._data.characters.dad.angle;
            
            if (!currentStage.members.contains(opponent)) {
                currentStage.characters.set('dad', opponent);
                currentStage.add(opponent);
            }

            opponent.playAnimation(opponent._data.animations[0].name);
            opponent.animation.finish();
            opponent.updateHitbox();
        }

        if (spectator != null) {
            spectator.zIndex = currentStage._data.characters.gf.zIndex;
            spectator.flipX = spectator._data.flipX;
            if (currentStage._data.characters.gf.flipX)
                spectator.flipX = !spectator.flipX;
            spectator.x = currentStage._data.characters.gf.position[0] - spectator.characterOrigin.x;
            spectator.y = currentStage._data.characters.gf.position[1] - spectator.characterOrigin.y;
            spectator.scale.x = spectator._data.scale * (currentStage._data.characters.gf.scale ?? 1);
            spectator.scale.y = spectator._data.scale * (currentStage._data.characters.gf.scale ?? 1);
            spectator.scrollFactor.x = currentStage._data.characters.gf.scroll[0];
            spectator.scrollFactor.y = currentStage._data.characters.gf.scroll[1];
            spectator.alpha = currentStage._data.characters.gf.alpha;
            spectator.angle = currentStage._data.characters.gf.angle;
            
            if (!currentStage.members.contains(spectator)) {
                currentStage.characters.set('gf', spectator);
                currentStage.add(spectator);
            }

            spectator.playAnimation(spectator._data.animations[0].name);
            spectator.animation.finish();
            spectator.updateHitbox();
        }
        currentStage.refresh();
    }

    function reloadStageList() {
        stageList.dataSource.clear();

        var data = new Stage("mainStage");
        data.onCreate();
        
        customStageRegistry.set("mainStage", data._data);
        stageList.dataSource.add({ text: "Main Stage", id: "mainStage" });
        
        for (i in stageRegistry.entries.keys()) {
            if (!blacklist.contains(stageRegistry.entries.get(i).stageName)) {
                var data = new Stage(i);
                if (save.data.precacheStages)
                    data.onCreate();
                customStageRegistry.set(i, data._data);
                stageList.dataSource.add({ text: stageRegistry.entries.get(i).stageName, id: i });
            }
        }
    }

    function checkImageExists(id:String) {
        var fileExists = false;
        var foldersToCheck = [
            "assets/",
            "assets/" + currentStage._data.directory + "/",
        ];

        for (mod in PolymodHandler.getAllMods()) {
            foldersToCheck.push("mods/" + mod.id + "/");
        }

        for (i in foldersToCheck) {
            if (FileUtil.fileExists(i + "images/" + id + ".png") || FileUtil.directoryExists(i + "images/" + id))
                fileExists = true;
            
            if (FileUtil.fileExists(i + "shared/images/" + id + ".png") || FileUtil.directoryExists(i + "images/" + id))
                fileExists = true;
        }

        return fileExists;
    }

    function getCornerCircle(outer:Bool) {
        var theCircle = new FlxShapeCircle(0, 0, outer ? 15 : 10, {
            thickness: 3,
            color: outer ? 0xFFbbe3e9 : FlxColor.TRANSPARENT,
            pixelHinting: false,
            scaleMode: null,
            capsStyle: null,
            jointStyle: null,
            miterLimit: 200
        }, outer ? FlxColor.TRANSPARENT : 0xFFf7a7a7);
        theCircle.antialiasing = true;
        //add(outerRing);
        //theCircle.add(outerRing);
        return theCircle;
    }

    override function onFocusLost(e) {
        super.onFocusLost(e);
        focusTimer = 2;
    }

    override function onFocus(e) {
        super.onFocus(e);
        focusTimer = 2;
    }
}