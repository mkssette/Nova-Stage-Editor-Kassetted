using StringTools;

class StageEditorTheSecond extends MusicBeatState {

    var np = [];

    var discStageName;

    var editorSongSave;
    var precacheCharsSave;
    var precacheStagesSave;

    var history = [];
    var redoHistory = [];

    // var outlineShader = new FlxRuntimeShader(Assets.getText(Paths.frag("WhiteOutline")));

    // -- box???? -- \\
    var playerBoundingBox;
    var opponentBoundingBox;
    var spectatorBoundingBox;

    // --  Lines  -- \\
    var lL;
    var tL;
    var rL;
    var bL;

    // -- Edge Cs -- \\
    var tLC;
    var tMC;
    var tRC;

    var mLC;
    var mRC;

    var bLC;
    var bMC;
    var bRC;

    // --  Other -- \\
    var cC;
    var rC;
    var draggingHandle:String = null;
    var lastMouseWorldX:Float = 0;
    var lastMouseWorldY:Float = 0;
    var mouseWorldDeltaX:Float = 0;
    var mouseWorldDeltaY:Float = 0;

    var stageRegistry;
    var customStageRegistry = [
        "init" => {
            curData: null,
            ogData: null
        }
    ];

    var player;
    var opponent;
    var spectator;

    var menuBar;

    var stageIdList = [];

    var editorVersion = "???"; // Uses polymod meta now :D
    var editorTitle = "Nova Stage Editor Kassetted";
    var editorFolder = "??";

    var keybinds = [];

    var notificationManager = new NotificationManager();
	var windowManager = new WindowManager();

	var camHUD:FlxCamera;
	var camInteract:FlxCamera;
	var camGame:FlxCamera;
    var camBackground:FlxCamera;

    var rightClickMenu;

    var stageDataWindow;

    var editCharacterWindow;

    var editPropWindow;
    var editPropWindowOffset = 0;
    var editAnimToggle = false;
    var offsetTween:FlxTween;

    var editAnimationsWindow;
    var userGuideWindow;

    var saveAsComponent;

    var propListView;
    var characterListView;
    var stageList;

    var currentStage:Stage;

    var selectedProp;
    var selectedCharacter;
    var selectedCharacterType = "none";

    var yLine;
    var xLine;

    var cancelInput(get, never):Bool;
    function get_cancelInput():Bool {
        var isMouseOverUI = false;
        if (stageDataWindow != null && stageDataWindow.exists && stageDataWindow.cameras != null && FlxG.mouse.overlaps(stageDataWindow)) isMouseOverUI = true;
        if (editCharacterWindow != null && editCharacterWindow.exists && editCharacterWindow.cameras != null && FlxG.mouse.overlaps(editCharacterWindow)) isMouseOverUI = true;
        if (editPropWindow != null && editPropWindow.exists && editPropWindow.cameras != null && FlxG.mouse.overlaps(editPropWindow)) isMouseOverUI = true;
        if (editAnimationsWindow != null && editAnimationsWindow.exists && editAnimationsWindow.cameras != null && FlxG.mouse.overlaps(editAnimationsWindow)) isMouseOverUI = true;
        if (userGuideWindow != null && userGuideWindow.exists && userGuideWindow.cameras != null && FlxG.mouse.overlaps(userGuideWindow)) isMouseOverUI = true;
        if (menuBar != null && menuBar.exists && menuBar.cameras != null && FlxG.mouse.overlaps(menuBar)) isMouseOverUI = true;

        var hasFocus = false;
        if (FocusManager.instance != null && FocusManager.instance.focus != null) {
            hasFocus = true;
        }

        return isMouseOverUI || hasFocus;
    }



    var doubleClickTween;
    var clickIndex = 0;

    var editAnimationCallback;

    var hasCharacterEditorInstalled:Bool = false;

    var blacklist = [
        "Main Stage",
        "Main Stage [Erect]",

        "Spooky Mansion",
        "Spooky Mansion [Erect]",

        "Christmas Mall (Nice)",
        "Christmas Mall (Naughty)",
        "Christmas Mall (Nice) [Erect]",

        "Limo Ride",
        "Limo Ride [Erect]",

        "Philly (Train)",
        "Philly (Blazin')",
        "Philly (Streets)",
        "Philly (Train) [Erect]",
        "Philly (Streets) [Erect]",

        "School (Date)",
        "School (Hate)",
        "School (Date) [Pico]",
        "School (Date) [Erect]",
        "School (Hate) [Erect]",

        "Tankman Battlefield",
        "Tankman Battlefield [Erect]"
    ];

    /* -- Button Callbacks -- */
    var editPropCallback;
    var duplicatePropCallback;
    var deletePropCallback;

    var characterListViewCallback;
    var propListViewCallback;

    function new() {
        super('StageEditorTheSecond');
    }



    function create() {
        super.create();
        Cursor.show();

        var style = RuntimeComponentBuilder.build(Paths.ui("stage-editor/styles/main"));
        add(style);

        

        

        SaveUtil.createSave('nova-editors');

        if (SaveUtil.getFromSave('nova-editors', 'editorSong') == null) {
            SaveUtil.writeToSave('nova-editors', 'editorSong', {
                title: "Artistic Expression",
                key: "chartEditorLoop"
            });
        }

        if (SaveUtil.getFromSave('nova-editors', 'precacheChars') == null) {
            SaveUtil.writeToSave('nova-editors', 'precacheChars', true);
        }

        if (SaveUtil.getFromSave('nova-editors', 'precacheStages') == null) {
            SaveUtil.writeToSave('nova-editors', 'precacheStages', true);
        }

        editorSongSave = SaveUtil.getFromSave('nova-editors', 'editorSong');
        precacheCharsSave = SaveUtil.getFromSave('nova-editors', 'precacheChars');
        precacheStagesSave = SaveUtil.getFromSave('nova-editors', 'precacheStages');

		FunkinSound.playMusic(editorSongSave.key, {startingVolume: 1, overrideExisting: true, restartTrack: false, persist: true, loop: true});

		

        camBackground = new FlxCamera();
        camBackground.bgColor = 0xFF000000;
        FlxG.cameras.add(camBackground, false);

        camGame = new FlxCamera();
        camGame.bgColor = 0x00000000;
        FlxG.cameras.add(camGame, false);

        camInteract = new FlxCamera();
        camInteract.bgColor = 0x00000000;
        FlxG.cameras.add(camInteract, false);

        camHUD = new FlxCamera();
        camHUD.bgColor = 0x00000000;
        FlxG.cameras.add(camHUD, true);

        trace("\n\n\n\n\n\n");
        for (i in PolymodHandler.getAllMods()) {
            if (i.title == editorTitle) {
                editorFolder = i.id;
                editorVersion = i.modVersion.version.join(".") + "-beta";
            }
            if (i.title == "Nova Character Editor") {
                hasCharacterEditorInstalled = true;
            }
        }

        var nameList = [];
        var idList = [];
        for (i in CharacterDataParser.characterCache.keys()) {
            nameList.push(CharacterDataParser.characterCache.get(i).name);
            if (precacheCharsSave) {
                var c = CharacterDataParser.characterCache.get(i);
                var assetsToLoad = [];
                assetsToLoad.push(c.assetPath);
                for (i in c.animations) {
                    if (i.assetPath != null) {
                        assetsToLoad.push(i.assetPath);
                    }
                }
                for (i in assetsToLoad) {
                    new FunkinSprite().loadGraphic(Paths.image(i));
                }
            }
            idList.push(CharacterDataParser.characterCache.get(i).id);
        }
        nameList.sort(SortUtil.alphabetically);
        idList.sort(SortUtil.alphabetically);

        stageRegistry = new StageRegistry();
        stageRegistry.loadEntries();

        var bg = new FunkinSprite(0, 0).loadGraphic(Paths.image('menuDesat'));
		bg.scrollFactor.set(0, 0);
		bg.setGraphicSize(FlxG.width, FlxG.height);
		bg.updateHitbox();
		bg.screenCenter();
		bg.alpha = 0.25;
		bg.cameras = [camBackground];
		add(bg);

        menuBar = RuntimeComponentBuilder.build(Paths.ui("stage-editor/menubar"));
        menuBar.findComponent("menuBarTitle").text = editorTitle + " v" + editorVersion;

        

        var resetCamera = menuBar.findComponent("resetCamera");

        resetCameraCallback = () -> FlxTween.tween(camGame, { zoom: currentStage.camZoom }, 0.25, { ease: FlxEase.quartOut });

        bind(resetCamera, MouseEvent.CLICK, resetCameraCallback);
        newKeybind(["CONTROL", "SHIFT", "R"], () -> { if (!cancelInput) resetCameraCallback(); });

        
        trace(precacheCharsSave);
        trace(precacheStagesSave);

        menuBar.findComponent("precacheCharacters").selected = precacheCharsSave;
        menuBar.findComponent("precacheCharacters").onChange = ()->{
            precacheCharsSave = menuBar.findComponent("precacheCharacters").selected;
            SaveUtil.writeToSave('nova-editors', 'precacheChars', precacheCharsSave);
            trace("Precache Characters: " + precacheCharsSave);
        }

        menuBar.findComponent("precacheStages").selected = precacheStagesSave;
        menuBar.findComponent("precacheStages").onChange = ()->{
            precacheStagesSave = menuBar.findComponent("precacheStages").selected;
            SaveUtil.writeToSave('nova-editors', 'precacheStages', precacheStagesSave);
            trace("Precache Stages: " + precacheStagesSave);
        }

        add(menuBar);

        StageEditorFile.init(this);
        
        newKeybind(["CONTROL", "R"], ()->{
            if (cancelInput) return;
            if (!FlxG.keys.pressed.SHIFT) {
                currentStage.resetStage();
                resetChars();
            }
        });

        

        var userGuideCallback = ()->{
            userGuideWindow = RuntimeComponentBuilder.build(Paths.ui("stage-editor/windows/userGuideWindow"));
            userGuideWindow.windowManager = windowManager;
            add(userGuideWindow);
            userGuideWindow.screenCenter();

            userGuideWindow.findComponent("closeButton").onClick = ()->{
                windowManager.closeWindow(userGuideWindow);
            }

            for (i in ["joinNovaButton", "joinNetworkButton"]) {
                userGuideWindow.findComponent(i).onClick = ()->{
                    FlxG.openURL(userGuideWindow.findComponent(i).tooltip);
                }
            }
        }

        newKeybind(["F1"], () -> { if (!cancelInput) userGuideCallback(); }, "justPressed");

        bind(menuBar.findComponent("userGuide"), MouseEvent.CLICK, userGuideCallback);

        stageDataWindow = RuntimeComponentBuilder.build(Paths.ui("stage-editor/windows/stageDataWindow"));
        stageDataWindow.screenCenter();
        stageDataWindow.windowManager = windowManager;
        add(stageDataWindow);

        stageDataWindow.title = "Stage Data";
        stageDataWindow.x = FlxG.width - stageDataWindow.width - 10;
        stageDataWindow.y = menuBar.height + 10;

        stageList = stageDataWindow.findComponent("stageDropdown");

        reloadStageList();

        var deletePropButton = stageDataWindow.findComponent("deletePropButton");
        deletePropCallback = ()->{
            if (selectedProp == null) return;
            for (i in currentStage._data.props) {
                if (i.name == selectedProp.name) {
                    currentStage._data.props.remove(i);
                }
            }
            deselectStage();
            refreshPropList();
            reloadStage();
            resetChars();

            propListView.selectedItem = propListView.dataSource.get(propListView.dataSource.size-1);
            propListView.selectedItems = [propListView.dataSource.get(propListView.dataSource.size-1)];

            new FlxTimer().start(0.05, ()->{
                propListView.selectedItem = propListView.dataSource.get(propListView.dataSource.size-1);
                propListView.selectedItems = [propListView.dataSource.get(propListView.dataSource.size-1)];
            });
        }
        bind(deletePropButton, MouseEvent.CLICK, deletePropCallback);
        newKeybind(["DELETE"], ()->{
            if (!cancelInput)
                deletePropCallback();
        });


        var newPropButton = stageDataWindow.findComponent("createPropButton");
        var newPropCallback = ()->{
            var proper = templateProp();
            currentStage._data.props.push(proper);
            refreshPropList();
            reloadStage();
            resetChars();

            
            propListView.selectedItem = propListView.dataSource.get(propListView.dataSource.size-1);
            propListView.selectedItems = [propListView.dataSource.get(propListView.dataSource.size-1)];
        }
        bind(newPropButton, MouseEvent.CLICK, newPropCallback);
        


        var editPropButton = stageDataWindow.findComponent("editPropButton");
        editPropCallback = ()->{
            if (selectedProp == null) {
                newNotification("Error!", "Please Select a Prop First.", NotificationType.Error);
            } else {

                

                var propData = getSelectedPropData();
                

                editPropWindow = RuntimeComponentBuilder.build(Paths.ui("stage-editor/windows/editPropWindow"));
                editPropWindow.screenCenter();
                editPropWindow.title = editPropWindow.title.replace("$propID", '"' + propData.name + '"');
                editPropWindow.windowManager = windowManager;
                add(editPropWindow);

                var nameTextField = editPropWindow.findComponent("editPropWindowNameTextField");
                nameTextField.text = propData.name;

                var assetPathTextField = editPropWindow.findComponent("editPropWindowAssetPathTextField");
                assetPathTextField.text = propData.assetPath;

                var colorPicker = editPropWindow.findComponent("editPropWindowColorPicker");
                colorPicker.selectedItem = selectedProp.color;
                colorPicker.onChange = ()->{
                    selectedProp.color = colorPicker.selectedItem;
                    propData.color = FlxColor.toWebString(colorPicker.selectedItem);
                }

                var animationTypeStepper = editPropWindow.findComponent("editPropWindowAnimationStepper");
                animationTypeStepper.onChange = ()->{
                    propData.animType = animationTypeStepper.selectedItem.data;
                }


                var blendModeDropdown = editPropWindow.findComponent("editPropWindowBlendModeDropdown");
                var blends = [
                    "" => { text: "None", data: "-1", id: "" },
                    "add" => { text: "Add", data: "0", id: "" },
                    "alpha" => { text: "Alpha", data: "1", id: "" },
                    "darken" => { text: "Darken", data: "2", id: "" },
                    "difference" => { text: "Difference", data: "3", id: "" },
                    "erase" => { text: "Erase", data: "4", id: "" },
                    "hardlight" => { text: "Hard Light", data: "5", id: "" },
                    "invert" => { text: "Invert", data: "6", id: "" },
                    "layer" => { text: "Layer", data: "7", id: "" },
                    "lighten" => { text: "Lighten", data: "8", id: "" },
                    "multiply" => { text: "Multiply", data: "9", id: "" },
                    "normal" => { text: "Normal", data: "10", id: "" },
                    "overlay" => { text: "Overlay", data: "11", id: "" },
                    "screen" => { text: "Screen", data: "12", id: "" },
                    "shader" => { text: "Shader", data: "13", id: "" },
                    "subtract" => { text: "Subtract", data: "14", id: "" }
                ];
                var item = blends.get(propData.blend);
                item.id = propData.blend;
                blendModeDropdown.selectedItem = item;
                blendModeDropdown.onChange = ()->{
                    propData.blend = blendModeDropdown.selectedItem.id;
                    selectedProp.blend = Std.parseInt(blendModeDropdown.selectedItem.data) != -1 ? Std.parseInt(blendModeDropdown.selectedItem.data) : null;
                }

                var xPosStepper = editPropWindow.findComponent("editPropWindowPosStepperX");
                xPosStepper.pos = Math.round(selectedProp.x);
                xPosStepper.onChange = ()->{
                    propData.position[0] = xPosStepper.pos;
                    selectedProp.x = xPosStepper.pos;
                }

                var yPosStepper = editPropWindow.findComponent("editPropWindowPosStepperY");
                yPosStepper.pos = Math.round(selectedProp.y);
                yPosStepper.onChange = ()->{
                    propData.position[1] = yPosStepper.pos;
                    selectedProp.y = yPosStepper.pos;
                }

                var xScrollPosStepper = editPropWindow.findComponent("editPropWindowScrollStepperX");
                xScrollPosStepper.pos = selectedProp.scrollFactor.x;
                xScrollPosStepper.onChange = ()->{
                    propData.scroll[0] = xScrollPosStepper.pos;
                    selectedProp.scrollFactor.x = xScrollPosStepper.pos;
                }

                var yScrollPosStepper = editPropWindow.findComponent("editPropWindowScrollStepperY");
                yScrollPosStepper.pos = selectedProp.scrollFactor.y;
                yScrollPosStepper.onChange = ()->{
                    propData.scroll[1] = yScrollPosStepper.pos;
                    selectedProp.scrollFactor.y = yScrollPosStepper.pos;
                }

                var scaleStepperX = editPropWindow.findComponent("editPropWindowScaleStepperX");
                scaleStepperX.pos = selectedProp.scale.x;

                var scaleStepperY = editPropWindow.findComponent("editPropWindowScaleStepperY");
                scaleStepperY.pos = selectedProp.scale.y;

                scaleStepperX.onChange = ()->{
                    propData.scale = Either.Right([scaleStepperX.pos, scaleStepperY.pos]);
                    selectedProp.scale.set(scaleStepperX.pos, scaleStepperY.pos);
                    selectedProp.updateHitbox();
                }

                scaleStepperY.onChange = ()->{
                    propData.scale = Either.Right([scaleStepperX.pos, scaleStepperY.pos]);
                    selectedProp.scale.set(scaleStepperX.pos, scaleStepperY.pos);
                    selectedProp.updateHitbox();
                }

                var alphaStepper = editPropWindow.findComponent("editPropWindowAlphaStepper");
                alphaStepper.pos = selectedProp.alpha;
                alphaStepper.onChange = ()->{
                    propData.alpha = alphaStepper.pos;
                    selectedProp.alpha = alphaStepper.pos;
                }

                var angleStepper = editPropWindow.findComponent("editPropWindowAngleStepper");
                angleStepper.pos = selectedProp.angle;
                angleStepper.onChange = ()->{
                    if (angleStepper.pos == -1) {
                        angleStepper.pos = 359;
                    } else if (angleStepper.pos == 360) {
                        angleStepper.pos = 0;
                    }
                    propData.angle = angleStepper.pos;
                    selectedProp.angle = angleStepper.pos;
                }

                var danceEveryStepper = editPropWindow.findComponent("editPropWindowDanceStepper");
                danceEveryStepper.pos = propData.danceEvery ?? 0;
                danceEveryStepper.onChange = ()->{
                    propData.danceEvery = danceEveryStepper.pos;
                }

                var zIndexStepper = editPropWindow.findComponent("editPropWindowZIndexStepper");
                zIndexStepper.pos = selectedProp.zIndex;
                zIndexStepper.onChange = ()->{
                    propData.zIndex = zIndexStepper.pos;
                    selectedProp.zIndex = zIndexStepper.pos;
                    currentStage.refresh();
                }

                var flipXCheck = editPropWindow.findComponent("editPropWindowFlipXCheckbox");
                flipXCheck.selected = selectedProp.flipX;
                flipXCheck.onChange = ()->{
                    propData.flipX = flipXCheck.selected;
                    selectedProp.flipX = flipXCheck.selected;
                }

                var flipYCheck = editPropWindow.findComponent("editPropWindowFlipYCheckbox");
                flipYCheck.selected = selectedProp.flipY;
                flipYCheck.onChange = ()->{
                    propData.flipY = flipYCheck.selected;
                    selectedProp.flipY = flipYCheck.selected;
                }

                var isPixelCheck = editPropWindow.findComponent("editPropWindowIsPixelCheckbox");
                isPixelCheck.selected = !selectedProp.antialiasing;
                isPixelCheck.onChange = ()->{
                    propData.isPixel = isPixelCheck.selected;
            selectedProp.antialiasing = !isPixelCheck.selected;
                }

                var editAnimationButton = editPropWindow.findComponent("editPropWindowAnimationsButton");
                editAnimationCallback = ()->{
                    if (!editAnimToggle) {
                        editAnimToggle = true;
                        if (offsetTween != null) offsetTween.cancel();
                        offsetTween = FlxTween.tween(editPropWindow, {x: editPropWindow.x - 390}, 0.5, { ease: FlxEase.quartOut });

                        editAnimationsWindow = RuntimeComponentBuilder.build(Paths.ui("stage-editor/windows/editPropAnimationWindow"));
                        editAnimationsWindow.windowManager = windowManager;
                        add(editAnimationsWindow);
                        
                        editAnimationsWindow.x = editPropWindow.x - 390 + editPropWindow.width + 10;
                        editAnimationsWindow.y = editPropWindow.y;

                        var editAnimationConfirmButton = editAnimationsWindow.findComponent("confirmButton");
                        bind(editAnimationConfirmButton, MouseEvent.CLICK, ()->{
                            if (offsetTween != null) offsetTween.cancel();
                            offsetTween = FlxTween.tween(editPropWindow, {x: editPropWindow.x + 390}, 0.5, { ease: FlxEase.quartOut });
                            windowManager.closeWindow(editAnimationsWindow);
                            editAnimToggle = false;
                            selectedProp.updateHitbox();
                        });

                        var acc1 = editAnimationsWindow.findComponent("ac1");

                        var refreshAnimationList = ()->{

                            var index = 0;
                            for (i in getSelectedPropData().animations) {

                                if (getSelectedPropData().startingAnimation == null && index == 0) {
                                    getSelectedPropData().startingAnimation = i.name;
                                }

                                var animation = RuntimeComponentBuilder.build(Paths.ui("stage-editor/parts/animationPart"));
                                animation.text = i.name;
                                animation.id = i.name;

                                var assetPathTextField = animation.findComponent("editAnimWindowAssetPathTextField");
                                assetPathTextField.text = i.assetPath;
                                assetPathTextField.onChange = ()->{
                                    i.assetPath = assetPathTextField.text;
                                    animation.text = i.assetPath;
                                    
                                }

                                var nameTextField = animation.findComponent("editAnimWindowAnimNameTextField");
                                nameTextField.text = i.name;
                                nameTextField.onChange = ()->{
                                    i.name = nameTextField.text;
                                    animation.text = i.name;
                                    animation.id = i.name;
                                }

                                var prefixTextField = animation.findComponent("editAnimWindowAnimPrefixTextField");
                                prefixTextField.text = i.prefix;
                                prefixTextField.onChange = ()->{
                                    i.prefix = prefixTextField.text;
                                }

                                var frameIndicesTextField = animation.findComponent("editAnimWindowAnimIndicesTextField");
                                frameIndicesTextField.text = i.frameIndices.join(", ");
                                frameIndicesTextField.onChange = ()->{
                                    frameIndicesTextField.text = frameIndicesTextField.text.replace("  ", " ");
                                    frameIndicesTextField.text = frameIndicesTextField.text.replace(" ,", ",");
                                    frameIndicesTextField.text = frameIndicesTextField.text.replace(",,", ",");
                                    i.frameIndices = stringToIndices(frameIndicesTextField.text);
                                    
                                }

                                var xOffsetStepper = animation.findComponent("editAnimWindowAnimOffsetXStepper");
                                xOffsetStepper.pos = Math.round(i.offsets[0]);
                                xOffsetStepper.onChange = ()->{
                                    i.offsets[0] = xOffsetStepper.pos;
                                }

                                var yOffsetStepper = animation.findComponent("editAnimWindowAnimOffsetYStepper");
                                yOffsetStepper.pos = Math.round(i.offsets[1]);
                                yOffsetStepper.onChange = ()->{
                                    i.offsets[1] = yOffsetStepper.pos;
                                }

                                var framerateStepper = animation.findComponent("editAnimWindowAnimFrameRateStepper");
                                framerateStepper.pos = i.frameRate;
                                framerateStepper.onChange = ()->{
                                    i.frameRate = framerateStepper.pos;
                                }

                                var flipXCheck = animation.findComponent("editPropWindowFlipXCheckbox");
                                flipXCheck.selected = i.flipX;
                                flipXCheck.onChange = ()->{
                                    i.flipX = flipXCheck.selected;
                                }

                                var flipYCheck = animation.findComponent("editPropWindowFlipYCheckbox");
                                flipYCheck.selected = i.flipY;
                                flipYCheck.onChange = ()->{
                                    i.flipY = flipYCheck.selected;
                                }

                                var loopedCheck = animation.findComponent("editPropWindowLoopedCheckbox");
                                loopedCheck.selected = i.looped;
                                loopedCheck.onChange = ()->{
                                    i.looped = loopedCheck.selected;
                                }

                                var isDefaultCheck = animation.findComponent("editPropWindowIsDefaultCheckbox");
                                isDefaultCheck.selected = getSelectedPropData().startingAnimation == i.name;
                                isDefaultCheck.onClick = ()->{
                                    getSelectedPropData().startingAnimation = isDefaultCheck.selected ? i.name : null;
                                    for (i2 in getSelectedPropData().animations) {
                                        acc1.findComponent(i2.name).findComponent("editPropWindowIsDefaultCheckbox").selected = getSelectedPropData().startingAnimation == i2.name;
                                    }
                                    selectedProp.animation.play(getSelectedPropData().startingAnimation, true);
                                }

                                acc1.addComponent(animation);

                                index++;
                            }
                        }
                        refreshAnimationList();

                        var newAnimationButton = editAnimationsWindow.findComponent("newAnimation");
                        newAnimationButton.onClick = ()->{
                            getSelectedPropData().animations.push(templateAnimation());
                            windowManager.closeWindow(editAnimationsWindow);
                            editAnimToggle = false;
                            editAnimationCallback();
                        }

                        var deleteAnimationButton = editAnimationsWindow.findComponent("deleteAnimation");
                        deleteAnimationButton.onClick = ()->{
                            for (i in getSelectedPropData().animations) {
                                if (i.name == acc1.selectedPage.id) {
                                    getSelectedPropData().animations.remove(i);
                                    windowManager.closeWindow(editAnimationsWindow);
                                    editAnimToggle = false;
                                    editAnimationCallback();

                                }
                            }
                        }
                    } else {
                        if (offsetTween != null) offsetTween.cancel();
                        offsetTween = FlxTween.tween(editPropWindow, {x: editPropWindow.x + 390}, 0.5, { ease: FlxEase.quartOut });
                        windowManager.closeWindow(editAnimationsWindow);
                        editAnimToggle = false;
                    }
                }
                bind(editAnimationButton, MouseEvent.CLICK, editAnimationCallback);

                var editConfirmButton = editPropWindow.findComponent("editPropWindowConfirm");
                bind(editConfirmButton, MouseEvent.CLICK, ()->{
                    if (nameTextField.text == "") {
                        newNotification("Error!", '"Prop Name" must not be blank.', NotificationType.Error);
                    }
                    if (assetPathTextField.text == "") {
                        newNotification("Error!", '"Asset Path" must not be blank.', NotificationType.Error);
                    }
                    if (nameTextField.text != "" && assetPathTextField.text != "" && checkImageExists(assetPathTextField.text)) {
                        windowManager.closeWindow(editPropWindow);
                        if (editAnimationsWindow != null)
                            windowManager.closeWindow(editAnimationsWindow);
                        propData.name = nameTextField.text;
                        propData.assetPath = assetPathTextField.text;
                        reloadStage();
                        
                        deselectChars();
                        refreshPropList();
                        resetChars();
                        editAnimToggle = false;
                        FlxTween.num(editPropWindowOffset, 0, 1.0, { ease: FlxEase.quartOut }, function(num) { editPropWindowOffset = num; });
                        propListViewCallback();
                    } else if (!checkImageExists(assetPathTextField.text)) {
                        FlxTween.color(assetPathTextField, 1.0, FlxColor.RED, FlxColor.WHITE);
                        newNotification("Error!", '"Asset Path" is not valid.', NotificationType.Error);
                    }
                });
            }
        }
        bind(editPropButton, MouseEvent.CLICK, editPropCallback);

        var playerDropdown = stageDataWindow.findComponent("playerDropdown");
        var opponentDropdown = stageDataWindow.findComponent("opponentDropdown");
        var spectatorDropdown = stageDataWindow.findComponent("spectatorDropdown");
        for (i in nameList) {
            playerDropdown.dataSource.add({text: i});
            opponentDropdown.dataSource.add({text: i});
            spectatorDropdown.dataSource.add({text: i});
        }

        playerDropdown.onChange = ()->{
            currentStage.getBoyfriend(true);
            for (i in CharacterDataParser.characterCache.keys()) {
                if (CharacterDataParser.characterCache.get(i).name == playerDropdown.selectedItem.text) {
                    player = CharacterDataParser.fetchCharacter(i);
                    player.debug = true;
                    resetChars();
                    break;
                }
            }
            deselectChars();
            deselectStage();
            resetChars();
        }

        opponentDropdown.onChange = ()->{
            currentStage.getDad(true);
            for (i in CharacterDataParser.characterCache.keys()) {
                if (CharacterDataParser.characterCache.get(i).name == opponentDropdown.selectedItem.text) {
                    opponent = CharacterDataParser.fetchCharacter(i);
                    opponent.debug = true;
                    resetChars();
                    break;
                }
            }
            deselectChars();
            deselectStage();
            resetChars();
        }

        spectatorDropdown.onChange = ()->{
            currentStage.getGirlfriend(true);
            for (i in CharacterDataParser.characterCache.keys()) {
                if (CharacterDataParser.characterCache.get(i).name == spectatorDropdown.selectedItem.text) {
                    spectator = CharacterDataParser.fetchCharacter(i);
                    spectator.debug = true;
                    resetChars();
                    break;
                }
            }
            deselectChars();
            deselectStage();
            resetChars();
        }


        

        propListView = stageDataWindow.findComponent("propsListView");
        characterListView = stageDataWindow.findComponent("charactersListView");



        characterListView.onChange = characterListViewCallback = ()->{
            deselectStage(0.5);
            switch (characterListView.selectedItem.text) {
                case "Player":
                    if (player != null) {
                        player.alpha = (player._data.alpha ?? 1);
                        selectedCharacter = player;
                        selectedCharacterType = "bf";
                    } else {
                        deselectChars();
                        deselectStage();
                    }
                case "Opponent":
                    if (opponent != null) {
                        opponent.alpha = (opponent._data.alpha ?? 1);
                        selectedCharacter = opponent;
                        selectedCharacterType = "dad";
                    } else {
                        deselectChars();
                        deselectStage();
                    }
                case "Spectator":
                    if (spectator != null) {
                        spectator.alpha = (spectator._data.alpha ?? 1);
                        selectedCharacter = spectator;
                        selectedCharacterType = "gf";
                    } else {
                        deselectChars();
                        deselectStage();
                    }
            }
        }

        propListView.onClick = ()->{
            clickIndex++;
            if (doubleClickTween != null)
                doubleClickTween.cancel();
            doubleClickTween = new FlxTimer().start(0.25, ()->{
                clickIndex = 0;
            });
            if (clickIndex == 2) {
                if (selectedProp != null) {
                    editPropCallback();
                }
            }
        }

        propListView.onChange = propListViewCallback = ()->{
            
            
            
            selectedProp = currentStage.getNamedProp(propListView.selectedItem.text);
            

            currentStage.forEachAlive((i)->{
                if (i.name == opponent.name || i.name == player.name || i.name == spectator.name) {
                    i.alpha = switch (i.name) {
                        case player.name:
                            currentStage._data.characters.bf?.alpha ?? 1;
                        case opponent.name:
                            currentStage._data.characters.dad?.alpha ?? 1;
                        case spectator.name:
                            currentStage._data.characters.gf?.alpha ?? 1;
                    }
                } else {
                    i.alpha = getSelectedPropData().alpha;
                }
            });
            deselectChars();
            
            
            
        }



        stageList.onChange = ()->{
            if (stageList.selectedItem.id == null) return;
            history = [];
            redoHistory = [];
            if (members.contains(currentStage)) {
                remove(currentStage);
            }
            currentStage = new Stage('mainStage');
            currentStage._cameras = [camGame];
            currentStage.onCreate();
            currentStage._data = customStageRegistry.get(stageList.selectedItem.id);
            currentStage.id = stageList.selectedItem.id;
            
            reloadStage();
            insert(0, currentStage);

            refreshPropList();

            stageDataWindow.findComponent("stageNameTextField").text = stageList.selectedItem.text;
            stageDataWindow.findComponent("defualtCamZoomStepper").pos = currentStage.camZoom;
