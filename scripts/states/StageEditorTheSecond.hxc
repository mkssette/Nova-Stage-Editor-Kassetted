import StringTools;
import Reflect;
import Math;

class StageEditorTheSecond extends MusicBeatState {

    var stageIdList = [];

    var editorVersion = "v2.0.0";
    var editorTitle = "Nova Stage Editor";
    var editorFolder = "??";

    var keybinds = [];

    var notificationManager = new NotificationManager();
	var windowManager = new WindowManager();

	var camHUD:FlxCamera;
	var camGame:FlxCamera;
    var camBackground:FlxCamera;

    var editPropWindow;
    var saveAsComponent;
    
    var propListView;
    var characterListView;

    var currentStage:Stage;

    var selectedProp;

    var yLine;
    var xLine;

    var cancelInput = false;

    var deselectStage;
    var deselectChars;

    function new() {
        super('StageEditorTheSecond');
    }

    function create() {
        super.create();
        Cursor.show();

		var chartEditor = new ChartEditorState();

        camBackground = new FlxCamera();
        camBackground.bgColor = 0xFF000000;
        FlxG.cameras.add(camBackground, false);

        camGame = new FlxCamera();
        camGame.bgColor = 0x00000000;
        FlxG.cameras.add(camGame, false);

        camHUD = new FlxCamera();
        camHUD.bgColor = 0x00000000;
        FlxG.cameras.add(camHUD, true);

        for (i in PolymodHandler.getAllMods()) {
            if (i.title == editorTitle) {
                editorFolder = i.id;
            }
        }

        var nameList = [];
        for (i in CharacterDataParser.characterCache.keys()) {
            nameList.push(CharacterDataParser.characterCache.get(i).name);
        }
        nameList.sort(SortUtil.alphabetically);

        var stageRegistry = new StageRegistry();
        stageRegistry.loadEntries();

        var blacklist = [
            "Main Stage [Erect]",
            
            "Spooky Mansion",
            "Spooky Mansion [Erect]",
            
            "Christmas Mall (Nice)", 
            "Christmas Mall (Naughty)", 
            "Christmas Mall (Nice) [Erect]", 
            
            "Limo Ride", 
            "Limo Ride [Erect]", 
            
            "Philly (Train)",
            "Philly (Blazin')", 
            "Philly (Streets)", 
            "Philly (Train) [Erect]",
            "Philly (Streets) [Erect]",
            
            "School (Date)",
            "School (Hate)",
            "School (Date) [Pico]",
            "School (Date) [Erect]",
            "School (Hate) [Erect]",

            "Tankman Battlefield",
            "Tankman Battlefield [Erect]"
        ];
        var stageNameList = [];
        
        for (i in stageRegistry.entries.keys()) {
            if (!blacklist.contains(stageRegistry.entries.get(i).stageName)) {
                stageIdList.push(i);
                stageNameList.push(stageRegistry.entries.get(i).stageName);
            }
        }
        stageNameList.sort(SortUtil.alphabetically);
        stageIdList.sort(SortUtil.alphabetically);
        trace(stageNameList);

        var bg = new FunkinSprite(0, 0).loadGraphic(Paths.image('menuDesat'));
		bg.scrollFactor.set(0, 0);
		bg.setGraphicSize(FlxG.width, FlxG.height);
		bg.updateHitbox();
		bg.screenCenter();
		bg.alpha = 0.25;
		bg.cameras = [camBackground];
		add(bg);

        var menuBar = RuntimeComponentBuilder.build(Paths.ui("stage-editor/menubar"));
        menuBar.findComponent("menuBarTitle").text = editorTitle + " " + editorVersion;

        var resetCamera = menuBar.findComponent("resetCamera");

        resetCameraCallback = () -> FlxTween.tween(camGame, { zoom: currentStage.camZoom }, 0.25, { ease: FlxEase.quartOut });

        bind(resetCamera, MouseEvent.CLICK, resetCameraCallback);
        newKeybind(["CONTROL", "SHIFT", "R"], resetCameraCallback);

        add(menuBar);

        var exit = ()->{
            FlxG.switchState(new MainMenuState());
		}

        var exitToMenuItem = menuBar.findComponent("exitToMenu");
        exitToMenuItem.onClick = exit;
        newKeybind(["CONTROL", "Q"], exit);

        saveAsComponent = menuBar.findComponent("saveStageAs");
        //bind(saveAsComponent, MouseEvent.CLICK, test);

        var saveStageComponent = menuBar.findComponent("saveStage");
        var saveStageCallback = ()->{
            /* trace(stringed);
            trace(currentStage.id); */
            if (currentStage.id == "mainStage") {
                newNotification("Error!", 'Could not save stage!\n"assets" is protected.', NotificationType.Error, 5000);
                return;
            }
		    for (mod in PolymodHandler.getAllMods()) {
                if (FileUtil.directoryExists("mods/" + mod.id + "/data/stages/")) {
                    if (FileUtil.readDir("mods/" + mod.id + "/data/stages/").contains(currentStage.id + ".json")) {
                        var path = "mods/" + mod.id + "/data/stages/" + currentStage.id + ".json";
		                FileUtil.deleteFile(path);
                        var parsed = Json.parse(currentStage._data.serialize());
                        parsed.directory = "Generated By: " + editorTitle + " " + editorVersion;
                        parsed.version = "1.0.0";
		                FileUtil.writeStringToPath(path, Json.stringify(parsed, null, "\t"));

                        newNotification("Success!", 'Successfully saved stage to "' + path + '"', NotificationType.Success, 5000);
                        return;
                    }
                }
            }
        }
        //saveStageComponent.onClick = saveStageCallback;
        bind(saveStageComponent, MouseEvent.CLICK, saveStageCallback);
        newKeybind(["CONTROL", "S"], saveStageCallback);
        newKeybind(["CONTROL", "R"], ()->{
            if (!FlxG.keys.pressed.SHIFT) 
                currentStage.resetStage();
        });

        var stageDataWindow = RuntimeComponentBuilder.build(Paths.ui("stage-editor/windows/stageDataWindow"));
        stageDataWindow.screenCenter();
        stageDataWindow.windowManager = windowManager;
        add(stageDataWindow);

        stageDataWindow.title = "Stage Data";
        stageDataWindow.x = FlxG.width - stageDataWindow.width - 10;
        stageDataWindow.y = menuBar.height + 10;

        var editPropButton = stageDataWindow.findComponent("editPropButton");
        bind(editPropButton, MouseEvent.CLICK, ()->{
            if (selectedProp == null) {
                newNotification("Error!", "Please Select a Prop First.", NotificationType.Error);
            } else {
                cancelInput = true;
                var propData = getSelectedPropData();
                trace(propData);

                editPropWindow = RuntimeComponentBuilder.build(Paths.ui("stage-editor/windows/editPropWindow"));
                editPropWindow.screenCenter();
                editPropWindow.title = StringTools.replace(editPropWindow.title, "$propID", '"' + propData.name + '"');
                editPropWindow.windowManager = windowManager;
                add(editPropWindow);

                var nameTextField = editPropWindow.findComponent("editPropWindowNameTextField");
                nameTextField.text = propData.name;

                var assetPathTextField = editPropWindow.findComponent("editPropWindowAssetPathTextField");
                assetPathTextField.text = propData.assetPath;

                var colorPicker = editPropWindow.findComponent("editPropWindowColorPicker");
                colorPicker.selectedItem = selectedProp.color;
                colorPicker.onChange = ()->{
                    selectedProp.color = colorPicker.selectedItem;
                    propData.color = FlxColor.toWebString(colorPicker.selectedItem);
                }

                var animationTypeStepper = editPropWindow.findComponent("editPropWindowAnimationStepper");
                animationTypeStepper.onChange = ()->{
                    trace(animationTypeStepper.selectedItem);
                }


                var blendModeDropdown = editPropWindow.findComponent("editPropWindowBlendModeDropdown");
                var blends = [
                    "" => { text: "None", data: "-1", id: "" },
                    "add" => { text: "Add", data: "0", id: "" },
                    "alpha" => { text: "Alpha", data: "1", id: "" },
                    "darken" => { text: "Darken", data: "2", id: "" },
                    "difference" => { text: "Difference", data: "3", id: "" },
                    "erase" => { text: "Erase", data: "4", id: "" },
                    "hardlight" => { text: "Hard Light", data: "5", id: "" },
                    "invert" => { text: "Invert", data: "6", id: "" },
                    "layer" => { text: "Layer", data: "7", id: "" },
                    "lighten" => { text: "Lighten", data: "8", id: "" },
                    "multiply" => { text: "Multiply", data: "9", id: "" },
                    "normal" => { text: "Normal", data: "10", id: "" },
                    "overlay" => { text: "Overlay", data: "11", id: "" },
                    "screen" => { text: "Screen", data: "12", id: "" },
                    "shader" => { text: "Shader", data: "13", id: "" },
                    "subtract" => { text: "Subtract", data: "14", id: "" }
                ];
                var item = blends.get(propData.blend);
                item.id = propData.blend;
                blendModeDropdown.selectedItem = item;
                blendModeDropdown.onChange = ()->{
                    propData.blend = blendModeDropdown.selectedItem.id;
                    selectedProp.blend = Std.parseInt(blendModeDropdown.selectedItem.data) != -1 ? Std.parseInt(blendModeDropdown.selectedItem.data) : null;
                }

                var editConfirmButton = editPropWindow.findComponent("editPropWindowConfirm");
                bind(editConfirmButton, MouseEvent.CLICK, ()->{
                    if (nameTextField.text == "") {
                        newNotification("Error!", '"Prop Name" must not be blank.', NotificationType.Error);
                    }
                    if (assetPathTextField.text == "") {
                        newNotification("Error!", '"Asset Path" must not be blank.', NotificationType.Error);
                    }
                    if (nameTextField.text != "" && assetPathTextField.text != "") {
                        cancelInput = false;
                        windowManager.closeWindow(editPropWindow);
                        propData.name = nameTextField.text;
                        propData.assetPath = assetPathTextField.text;
                        for (i in currentStage.members) {
                            currentStage.remove(i);
                        }
                        currentStage.buildStage();
                        deselectStage();
                        deselectChars();
                        refreshPropList();
                    }
                });
            }
        });      

        var playerDropdown = stageDataWindow.findComponent("playerDropdown");
        var opponentDropdown = stageDataWindow.findComponent("opponentDropdown");
        var spectatorDropdown = stageDataWindow.findComponent("spectatorDropdown");
        for (i in nameList) {
            playerDropdown.dataSource.add({text: i});
            opponentDropdown.dataSource.add({text: i});
            spectatorDropdown.dataSource.add({text: i});
        }

        var stageList = stageDataWindow.findComponent("stageDropdown");
        for (i in stageNameList) stageList.dataSource.add({text: i});

        /* var propListView = stageDataWindow.findComponent("propsListView");
        propListView.onDataChanged = (data) -> {
            trace(data);
        } */
        
        propListView = stageDataWindow.findComponent("propsListView");
        characterListView = stageDataWindow.findComponent("charactersListView");

        deselectStage = function(?target:Float) {
            propListView.selectedItems = [];
            selectedProp = null;
            for (i in currentStage.members) {
                i.alpha = target ?? 1;
            }
        };

        deselectChars = ()->{
            characterListView.selectedItems = [];
            /* selectedProp = null;
            for (i in currentStage.members) {
                i.alpha = 1;
            } */
        };

        characterListView.onChange = ()->{
            deselectStage(0.5);
        }

        propListView.onChange = ()->{
            /* xLine.scrollFactor.y = currentStage.getNamedProp(propListView.selectedItem.text).scrollFactor.y;
            yLine.scrollFactor.x = currentStage.getNamedProp(propListView.selectedItem.text).scrollFactor.x; */
            selectedProp = currentStage.getNamedProp(propListView.selectedItem.text);

            for (i in currentStage.members) {
                if (i != currentStage.getNamedProp(propListView.selectedItem.text)) {
                    i.alpha = 0.5;
                } else {
                    i.alpha = 1;
                }
            }
            deselectChars();
        }

        newKeybind(["ESCAPE"], deselectStage);
        newKeybind(["ESCAPE"], deselectChars);

        stageList.onChange = ()->{
            for (i in stageRegistry.entries.keys()) {
                if (stageRegistry.entries.get(i).stageName == stageList.selectedItem.text) {
                    if (members.contains(currentStage)) {
                        remove(currentStage);
                    }
                    currentStage = new Stage(i);
                    currentStage._cameras = [camGame];
                    currentStage.onCreate();
                    insert(0, currentStage);

                    refreshPropList();

                    stageDataWindow.findComponent("stageNameTextField").text = stageRegistry.entries.get(i).stageName;
                    stageDataWindow.findComponent("defualtCamZoomStepper").pos = currentStage.camZoom;
                    FlxTween.tween(camGame, { zoom: currentStage.camZoom }, 0.25, { ease: FlxEase.quartOut });
                    FlxTween.tween(camGame.scroll, { x: -FlxG.width/2, y: -FlxG.height/2 }, 0.25, { ease: FlxEase.quartOut });
                    deselectStage();
                    deselectChars();
                }
            }
        }

        stageList.selectedItem = { text: "Main Stage" };
        
        /* editPropWindow = RuntimeComponentBuilder.build(Paths.ui("stage-editor/windows/editPropAnimationWindow"));
        editPropWindow.windowManager = windowManager; */
        // add(editPropWindow);

        initNotification();

        newKeybind(["W"], () -> !cancelInput ? camGame.scroll.y -= FlxG.keys.pressed.SHIFT ? 10 : !FlxG.keys.pressed.CONTROL ? 5 : 0 : 0, "pressed");
        newKeybind(["A"], () -> !cancelInput ? camGame.scroll.x -= FlxG.keys.pressed.SHIFT ? 10 : !FlxG.keys.pressed.CONTROL ? 5 : 0 : 0, "pressed");
        newKeybind(["S"], () -> !cancelInput ? camGame.scroll.y += FlxG.keys.pressed.SHIFT ? 10 : !FlxG.keys.pressed.CONTROL ? 5 : 0 : 0, "pressed");
        newKeybind(["D"], () -> !cancelInput ? camGame.scroll.x += FlxG.keys.pressed.SHIFT ? 10 : !FlxG.keys.pressed.CONTROL ? 5 : 0 : 0, "pressed");

        newKeybind(["Q"], () -> !cancelInput ? camGame.zoom -= 0.05 : 0, "pressed");
        newKeybind(["E"], () -> !cancelInput ? camGame.zoom += 0.05 : 0, "pressed");

        camGame.scroll.x = -FlxG.width/2;
        camGame.scroll.y = -FlxG.height/2;

        
        yLine = new FunkinSprite(0, 0).makeGraphic(1, 1, 0xFF00FF00);
        yLine.scale.y = 2000;
        yLine.antialiasing = true;
        yLine.cameras = [camGame];
        yLine.alpha = 0.5;
        add(yLine);

        xLine = new FunkinSprite(0, 0).makeGraphic(1, 1, 0xFFFF0000);
        xLine.antialiasing = true;
        xLine.cameras = [camGame];
        xLine.alpha = 0.5;
        add(xLine);

    }

    var targetSpriteY = 0;

    function update() {
        super.update();        
        get_conductorInUse().update();

        propListView.disabled = cancelInput;
        characterListView.disabled = cancelInput;

        if (editPropWindow != null)
            editPropWindow.screenCenter();

        if (FlxG.mouse.justPressed) {
            FlxG.sound.play(Paths.sound("click"));
        }

        for (keybind in keybinds) {
            var pressed = true;
            var index = 0;
            //trace(keybind);
            for (key in keybind.keys) {
                if (index == keybind.keys.length - 1 && keybind.type != "pressed") {
                    if (!Reflect.getProperty(FlxG.keys.justPressed, key)) {
                        pressed = false;
                    }
                } else {
                    if (!Reflect.getProperty(FlxG.keys.pressed, key)) {
                        pressed = false;
                    }
                }
                index++;
            }
            if (pressed) {
                keybind.action();
            }
        }

        if (camGame.zoom < 0.01) {
            camGame.zoom = 0.01;
        }

        yLine.scale.x = 1.5 * (1/camGame.zoom);
        yLine.scale.y = FlxG.height * (1/camGame.zoom);
        yLine.screenCenter();
        yLine.updateHitbox();
        yLine.x = -yLine.width/2;
        yLine.scrollFactor.y = 0;

        xLine.scale.y = 1.5 * (1/camGame.zoom);
        xLine.scale.x = FlxG.width * (1/camGame.zoom);
        xLine.screenCenter();
        xLine.updateHitbox();
        xLine.y = -xLine.height/2;
        xLine.scrollFactor.x = 0;

        if (selectedProp != null && FlxG.mouse.pressed && !cancelInput) {
            selectedProp.x += FlxG.mouse.deltaX / camGame.zoom;
            selectedProp.y += FlxG.mouse.deltaY / camGame.zoom;
            for (i in currentStage._data.props) {
                if (i.name == selectedProp.name) {
                    i.position[0] = Math.round(selectedProp.x);
                    i.position[1] = Math.round(selectedProp.y);
                }
            }
        }
    }

    function refreshPropList() {
        propListView.dataSource.clear();

        for (i in currentStage._data.props) {
            propListView.dataSource.add({ text: i.name });
        }
    }

    function getSelectedPropData() {
        if (selectedProp != null) {
            for (i in currentStage._data.props) {
                if (i.name == selectedProp.name) {
                    return i;
                }
            }
        }
    }

    override function beatHit() {
        super.beatHit();
        var curBeat = get_conductorInUse().currentBeat;
    }
    override function stepHit() {
        super.stepHit();
        var curStep = get_conductorInUse().currentStep;
    }

    function destroy() {
        super.destroy();
        Cursor.hide();
    }

    public function test() {
        FlxG.switchState(new MainMenuState());
    }

    function newNotification(title:String, body:String, ?type, ?expiryMs, ?actions) {
        notificationManager.addNotification({
            title: title,
            body: body,
            type: type ?? NotificationType.Default,
            expiryMs: expiryMs ?? null,
            actions: actions ?? []
        });
    }

    function initNotification() {
        notificationManager.addNotification({
            title: "Welcome!",
            body: "Welcome to the Nova Stage Editor! Press F1 for a user guide.",
            type: NotificationType.Default
        });
    }

    public function test2() {
        NotificationManager.instance.addNotification({
            title: "Test",
            body: "This is a test"
        });
    }

    function bind(component, mouseEvent, func) {
        switch (mouseEvent) {
            case MouseEvent.CLICK:
                component.onClick = func;
        }
    }

    function newKeybind(keys:Array<String>, action, ?type) {
        keybinds.push({
            keys: keys,
            type: type ?? "justPressed",
            action: action
        });
    }
}