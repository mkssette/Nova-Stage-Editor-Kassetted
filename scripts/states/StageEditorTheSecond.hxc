            resetCameraCallback();
            FlxTween.tween(camGame.scroll, { 
                x: player.cameraFocusPoint.x - (FlxG.width/2) + currentStage._data.characters.bf.cameraOffsets[0],
                y: player.cameraFocusPoint.y - (FlxG.height/2) + currentStage._data.characters.bf.cameraOffsets[1]
            }, 0.25, { ease: FlxEase.quartOut });
